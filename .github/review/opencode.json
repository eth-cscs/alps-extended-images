{
  "$schema": "https://opencode.ai/config.json",
  "model": "cscs/zai-org/GLM-5.3",
  "default_agent": "grumpy-reviewer",
  "share": "disabled",
  "instructions": ["AGENTS.md"],
  "permissions": [
    { "action": "edit", "resource": "*", "effect": "deny" },
    { "action": "external_directory", "resource": "/source", "effect": "allow" },
    { "action": "external_directory", "resource": "/source/**", "effect": "allow" },
    { "action": "external_directory", "resource": "/context/**", "effect": "allow" }
  ],
  "agents": {
    "title": { "model": "cscs/zai-org/GLM-5.3" },
    "summary": { "model": "cscs/zai-org/GLM-5.3" },
    "compaction": { "model": "cscs/zai-org/GLM-5.3" }
  },
  "providers": {
    "cscs": {
      "package": "@opencode/ai/providers/anthropic",
      "name": "CSCS Inference",
      "settings": {
        "baseURL": "https://api.inference.cscs.ch/v1",
        "apiKey": "{env:CSCS_INFERENCE_API_KEY}",
        "systemMessageMode": "system"
      },
      "models": {
        "zai-org/GLM-5.3": {
          "name": "GLM-5.3 [CSCS]",
          "limit": { "context": 1048576, "output": 32768 },
          "capabilities": { "tools": true, "input": ["text"], "output": ["text"] },
          "variants": [],
          "cost": {
            "input": 0.1811,
            "output": 6.642,
            "cache": { "read": 0, "write": 0 }
          }
        }
      }
    }
  }
}
