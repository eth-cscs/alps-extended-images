# syntax=docker/dockerfile:1

ARG BASE_IMAGE=quay.io/skopeo/stable:v1.24.0
FROM ${BASE_IMAGE}

LABEL org.opencontainers.image.title="Alps CI generator"
LABEL org.opencontainers.image.description="Python, PyYAML, and skopeo runtime for generating Alps Extended Images child pipelines"
LABEL org.opencontainers.image.vendor="CSCS"

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
      bash \
      ca-certificates \
      python3 \
      python3-yaml; \
    rm -rf /var/lib/apt/lists/*
