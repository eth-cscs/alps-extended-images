# syntax=docker/dockerfile:1

ARG BASE_IMAGE
FROM ${BASE_IMAGE}

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ARG OCI_SOURCE="unknown"
ARG OCI_REVISION="unknown"
ARG OCI_CREATED="unknown"
ARG OCI_DESCRIPTION="unknown"
ARG CSCS_ALPS_GIT_COMMIT_SHORT="unknown"

LABEL org.opencontainers.image.source="${OCI_SOURCE}" \
      org.opencontainers.image.revision="${OCI_REVISION}" \
      org.opencontainers.image.created="${OCI_CREATED}" \
      org.opencontainers.image.description="${OCI_DESCRIPTION}" \
      com.cscs.alps.git.repo="${OCI_SOURCE}" \
      com.cscs.alps.git.commit="${OCI_REVISION}" \
      com.cscs.alps.git.commit_short="${CSCS_ALPS_GIT_COMMIT_SHORT}"

# Shared stack build args. Defaults live in common/alps-stack-versions.env.
ARG BOOST_VER=""
ARG BOOST_BUILD_JOBS=""
ARG ALPS_BUILD_JOBS=""
ARG ALPS_CMAKE_BUILD_JOBS=""
ARG XPMEM_REF=""
ARG CASSINI_HEADERS_VERSION=""
ARG CXI_DRIVER_VERSION=""
ARG LIBCXI_VERSION=""
ARG LIBFABRIC_COMMIT=""
ARG LIBFABRIC_PATCH=""
ARG UCX_VERSION=""
ARG UCC_VERSION=""
ARG OMPI_VER=""
ARG AWS_OFI_NCCL_REPO=""
ARG AWS_OFI_NCCL_COMMIT=""
ARG AWS_OFI_NCCL_PATCH=""
ARG OSU_VERSION=""

ARG REMOVE_HPCX_DIRS=""

ARG GDRCOPY_VER=2.5.1

ARG NCCL_VER=2.30.7-1
ARG NCCL_PATCH=""

ARG NVSHMEM_VER=3.6.5-0
ARG NVSHMEM_PATCH="nvshmem/requirements-v3.6.5-0.patch"

ARG NCCL_TESTS_VER=2.18.2

COPY Alps-Images/patches/ /opt/alps/patches/
COPY Alps-Images/common/alps-stack-versions.env /opt/alps/alps-stack-versions.env
COPY Alps-Images/common/package-helpers.sh /opt/alps/package-helpers.sh
COPY Alps-Images/common/install-alps-hpc-stack.sh /opt/alps/install-alps-hpc-stack.sh
COPY Alps-Images/common/run-alps-variant-hooks.sh /opt/alps/run-alps-variant-hooks.sh
COPY Alps-Images/NGC/install-alps-cuda-components.sh /opt/alps/install-alps-cuda-components.sh
COPY Alps-Images/NGC/install-alps-cuda-stack.sh /opt/alps/install-alps-cuda-stack.sh

RUN set -eux; \
    chmod +x /opt/alps/install-alps-cuda-stack.sh; \
    /opt/alps/install-alps-cuda-stack.sh

COPY Alps-Images/common/alps-runtime.common.env /opt/alps/env/alps-runtime.common.env
COPY Alps-Images/common/alps-runtime.nccl-like.env /opt/alps/env/alps-runtime.nccl-like.env
COPY Alps-Images/NGC/alps-runtime.cuda.env /opt/alps/env/alps-runtime.cuda.env
COPY Alps-Images/common/source-alps-env.sh /opt/alps/env/source-alps-env.sh
COPY Alps-Images/common/install-alps-runtime-env.sh /opt/alps/env/install-alps-runtime-env.sh

RUN set -eux; \
    chmod +x /opt/alps/env/install-alps-runtime-env.sh; \
    ALPS_NVIDIA_ENTRYPOINT_HOOK=1 /opt/alps/env/install-alps-runtime-env.sh \
      /opt/alps/env/alps-runtime.common.env \
      /opt/alps/env/alps-runtime.nccl-like.env \
      /opt/alps/env/alps-runtime.cuda.env

COPY Alps-Images/common/alps-runtime-warning.txt /opt/alps/env/alps-runtime-warning.txt
COPY Alps-Images/common/alps-runtime-warning.sh /opt/alps/env/alps-runtime-warning.sh
COPY Alps-Images/common/alps-runtime-warning.py /opt/alps/env/alps-runtime-warning.py
COPY Alps-Images/common/install-alps-runtime-warnings.sh /opt/alps/env/install-alps-runtime-warnings.sh

RUN set -eux; \
    chmod +x /opt/alps/env/install-alps-runtime-warnings.sh; \
    /opt/alps/env/install-alps-runtime-warnings.sh

# Optional image-specific fixes (late hooks)
ARG NGC_VARIANT_DIR=""
COPY Alps-Images/NGC/${NGC_VARIANT_DIR}/ /opt/alps/ngc-variant/
RUN set -eux; \
    chmod +x /opt/alps/run-alps-variant-hooks.sh; \
    /opt/alps/run-alps-variant-hooks.sh /opt/alps/ngc-variant "NGC_VARIANT_DIR=${NGC_VARIANT_DIR}"
