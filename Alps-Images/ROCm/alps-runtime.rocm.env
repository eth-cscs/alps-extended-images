# -----------------------------------------------------------------------------
# ROCm / RCCL defaults
# -----------------------------------------------------------------------------
# ROCm/HIP version markers are injected at build time when available.
defvar ROCM_VERSION "${ROCM_VERSION:-}"
defvar RCCL_VERSION "${RCCL_VERSION:-}"

# The ROCm runtime defaults to lazy SDMA reclaim on some platforms. Keep the
# setting explicit for MI300-class collective benchmarks.
defvar HSA_NO_SCRATCH_RECLAIM "1"

# ldconfig indexes libraries by ELF SONAME (e.g. libamd_smi.so.26), not by
# bare development symlink names (e.g. libamd_smi.so).  Python ctypes.CDLL()
# calls dlopen() which resolves bare names by searching LD_LIBRARY_PATH first,
# so the ROCm SDK library directories must be on LD_LIBRARY_PATH.
# DEBUG: capture whether LD_LIBRARY_PATH was already set before defvar runs.
if [[ ${ALPS_EXTENDED_IMAGES_ENV_SOURCED:-} == 1 ]] || true; then
  >&2 echo "[DEBUG-env] LD_LIBRARY_PATH already set? ${LD_LIBRARY_PATH:+yes=[$LD_LIBRARY_PATH]}${LD_LIBRARY_PATH:-no}"
fi
defvar LD_LIBRARY_PATH "/opt/venv/lib/python3.12/site-packages/_rocm_sdk_devel/lib:/opt/venv/lib/python3.12/site-packages/_rocm_sdk_core/lib:/opt/venv/lib/python3.12/site-packages/_rocm_sdk_libraries/lib"
>&2 echo "[DEBUG-env] LD_LIBRARY_PATH after defvar: [${LD_LIBRARY_PATH:-EMPTY}]"
