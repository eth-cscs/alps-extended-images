# -----------------------------------------------------------------------------
# ROCm / RCCL defaults
# -----------------------------------------------------------------------------
# ROCm/HIP version markers are injected at build time when available.
defvar ROCM_VERSION "${ROCM_VERSION:-}"
defvar RCCL_VERSION "${RCCL_VERSION:-}"

# The ROCm runtime defaults to lazy SDMA reclaim on some platforms. Keep the
# setting explicit for MI300-class collective benchmarks.
defvar HSA_NO_SCRATCH_RECLAIM "1"

defvar HWLOC_COMPONENTS "-gl"
defvar NCCL_PXN_DISABLE "1"
defvar NCCL_NET_GDR_LEVEL "PHB"
#defvar FI_CXI_RX_MATCH_MODE "software"
defvar NCCL_GDRCOPY_ENABLE "1"
defvar NCCL_NET_FORCE_FLUSH "1"
defvar FI_CXI_DISABLE_NON_INJECT_MSG_IDC "1"
