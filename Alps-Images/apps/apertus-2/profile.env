APP_VARIANTS="megatron-base-cuda megatron-cuda megatron-rocm megatron-primus263-rocm megatron-primus268-rocm"

MEGATRON_BASE_CUDA_BASE_IMAGE=pytorch-cuda:25.12-py3
MEGATRON_BASE_CUDA_CONTAINERFILE=Containerfile.megatron-base
MEGATRON_BASE_CUDA_TEST_DIR=tests/megatron-base
MEGATRON_BASE_CUDA_SOURCE_FILES="sources/requirements.txt"

MEGATRON_CUDA_BASE_IMAGE=pytorch-cuda:26.06-py3
MEGATRON_CUDA_CONTAINERFILE=Containerfile.megatron
MEGATRON_CUDA_TEST_DIR=tests/megatron
MEGATRON_CUDA_SOURCE_FILES="sources/megatron/versions.env sources/megatron/install-system.sh sources/megatron/install-kernels.sh sources/megatron/requirements.in sources/megatron/requirements.lock"

MEGATRON_ROCM_BASE_IMAGE=pytorch-rocm:rocm10.0-ubuntu24.04-py3.12-torch2.13
MEGATRON_ROCM_CONTAINERFILE=Containerfile.megatron.rocm
MEGATRON_ROCM_TEST_DIR=tests/rocm
MEGATRON_ROCM_PATCH_DIR=patches/rocm
MEGATRON_ROCM_SOURCE_FILES="sources/rocm/versions.env sources/rocm/install.sh sources/rocm/install-uccl.sh sources/rocm/finalize-megatron.sh sources/rocm/requirements.in sources/rocm/requirements.lock sources/rocm/requirements.overrides"

MEGATRON_PRIMUS263_ROCM_BASE_IMAGE=primus-rocm:26.3
MEGATRON_PRIMUS263_ROCM_CONTAINERFILE=Containerfile.megatron.primus
MEGATRON_PRIMUS263_ROCM_TEST_DIR=tests/primus

MEGATRON_PRIMUS268_ROCM_BASE_IMAGE=primus-rocm:26.8
MEGATRON_PRIMUS268_ROCM_CONTAINERFILE=Containerfile.megatron.primus
MEGATRON_PRIMUS268_ROCM_TEST_DIR=tests/primus

# Both recipes COPY the compatibility patch tree; only the matching26.8 stack applies it.
MEGATRON_PRIMUS263_ROCM_PATCH_DIR=patches/primus
MEGATRON_PRIMUS268_ROCM_PATCH_DIR=patches/primus
