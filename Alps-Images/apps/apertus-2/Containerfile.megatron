# syntax=docker/dockerfile:1

ARG BASE_IMAGE
FROM ${BASE_IMAGE}

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ARG OCI_SOURCE="unknown"
ARG OCI_REVISION="unknown"
ARG OCI_CREATED="unknown"
ARG OCI_DESCRIPTION="unknown"
ARG CSCS_ALPS_GIT_COMMIT_SHORT="unknown"

LABEL org.opencontainers.image.source="${OCI_SOURCE}" \
      org.opencontainers.image.revision="${OCI_REVISION}" \
      org.opencontainers.image.created="${OCI_CREATED}" \
      org.opencontainers.image.description="${OCI_DESCRIPTION}" \
      com.cscs.alps.git.repo="${OCI_SOURCE}" \
      com.cscs.alps.git.commit="${OCI_REVISION}" \
      com.cscs.alps.git.commit_short="${CSCS_ALPS_GIT_COMMIT_SHORT}"

COPY Alps-Images/common/package-helpers.sh /opt/alps/package-helpers.sh
COPY Alps-Images/apps/apertus-2/sources/megatron/ /opt/alps/megatron/

ARG UCCL_MAX_JOBS=8
ARG TE_MAX_JOBS=8
ARG KERNEL_MAX_JOBS=8
ARG FA3_MAX_JOBS=8
ARG FA3_PTXAS_OPT=1
ARG FLASHINFER_CACHE_MAX_JOBS=16
ARG UV_PYTHON_DOWNLOADS=never

ENV UV_DEFAULT_INDEX=https://jfrog.svc.cscs.ch/artifactory/api/pypi/pypi-remote/simple \
    UCCL_EP_TRANSPORT=cxi \
    UCCL_P2P_TRANSPORT=cxi \
    UCCL_CXI_THREADING=safe

RUN bash /opt/alps/megatron/install-system.sh

# NeMoRun's pinned source uses the uv 0.8 metadata schema.
RUN set -eux; \
    source /opt/alps/package-helpers.sh; \
    source /opt/alps/megatron/versions.env; \
    export PIP_CONSTRAINT=/opt/alps/megatron/base-pins.txt; \
    pip_install python3 \
        --break-system-packages \
        --no-cache-dir \
        "uv==${UV_VERSION}"; \
    uv pip install \
        --system \
        --break-system-packages \
        --python python3 \
        --no-cache \
        --no-deps \
        --constraint /opt/alps/megatron/base-pins.txt \
        --requirement /opt/alps/megatron/requirements.lock; \
    uv --version; \
    curl --version; \
    git --version

RUN bash /opt/alps/megatron/install-kernels.sh uccl
RUN bash /opt/alps/megatron/install-kernels.sh transformer-engine
RUN bash /opt/alps/megatron/install-kernels.sh training
RUN bash /opt/alps/megatron/install-kernels.sh mamba
RUN bash /opt/alps/megatron/install-kernels.sh hadamard
RUN bash /opt/alps/megatron/install-kernels.sh flash-attention-3
RUN bash /opt/alps/megatron/install-kernels.sh flashinfer

COPY Alps-Images/apps/apertus-2/tests/megatron/ /opt/tests/apertus-2/megatron/
RUN python3 /opt/tests/apertus-2/megatron/check-stack.py --metadata-only

ENV PYTHONNOUSERSITE=1 \
    LD_PRELOAD="/usr/local/lib/python3.12/dist-packages/torch_memory_saver_hook_mode_preload_cu13.abi3.so:${LD_PRELOAD}"
