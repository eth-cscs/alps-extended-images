@@ -65,6 +65,18 @@
 typedef uint8_t __hip_fp8_storage_t;
 typedef uint16_t __hip_fp8x2_storage_t;
 #endif
+
+// ROCm 10 no longer exposes the CUDA-compatible global integer min/max
+// overloads expected by the kernels and HIP cooperative-groups headers.
+template <typename T, typename U>
+__host__ __device__ __forceinline__ constexpr auto min(T lhs, U rhs) {
+  return rhs < lhs ? rhs : lhs;
+}
+
+template <typename T, typename U>
+__host__ __device__ __forceinline__ constexpr auto max(T lhs, U rhs) {
+  return lhs < rhs ? rhs : lhs;
+}
 #define nv_bfloat16 hip_bfloat16
 #define __nv_fp8x2_storage_t __hip_fp8x2_storage_t
 #define __nv_fp8_storage_t __hip_fp8_storage_t
