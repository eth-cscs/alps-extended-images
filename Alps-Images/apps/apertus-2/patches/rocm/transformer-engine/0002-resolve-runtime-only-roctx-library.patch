Subject: [PATCH] Resolve ROCTX from the runtime-only wheel SDK

The ROCm 10 wheel ships libroctx64.so.4 without the unversioned development
link. Resolve its real library path instead of emitting an unresolvable
-lroctx64. Keep the existing ROCTX API and fail configuration if neither the
development name nor its packaged ABI-4 runtime is available.

Applies to Transformer Engine b56021a0e4a2e4a7822482ffdf5353368a777e0e.

diff --git a/transformer_engine/common/CMakeLists.txt b/transformer_engine/common/CMakeLists.txt
--- a/transformer_engine/common/CMakeLists.txt
+++ b/transformer_engine/common/CMakeLists.txt
@@ -743,5 +743,7 @@ else() #USE_ROCM
   find_package(hip)
-  list(APPEND transformer_engine_LINKER_LIBS hip::host hip::device roctx64)
+  find_library(ROCTX_LIBRARY NAMES roctx64 libroctx64.so.4
+               HINTS "${ROCM_PATH}/lib" REQUIRED)
+  list(APPEND transformer_engine_LINKER_LIBS hip::host hip::device "${ROCTX_LIBRARY}")
   find_package(hiprtc)
   list(APPEND transformer_engine_LINKER_LIBS hiprtc)
   find_package(hipblaslt)
diff --git a/transformer_engine/common/ck_fused_attn/CMakeLists.txt b/transformer_engine/common/ck_fused_attn/CMakeLists.txt
--- a/transformer_engine/common/ck_fused_attn/CMakeLists.txt
+++ b/transformer_engine/common/ck_fused_attn/CMakeLists.txt
@@ -235,7 +235,9 @@ target_include_directories(ck_fused_attn PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}/src/small_seq_kernels")
 find_package(hip)
 target_link_directories(ck_fused_attn PUBLIC ${__AITER_MHA_PATH})
-list(APPEND ck_fused_attn_LINKER_LIBS hip::host hip::device roctx64 -l:te_libmha_fwd.so -l:te_libmha_bwd.so)
+find_library(ROCTX_LIBRARY NAMES roctx64 libroctx64.so.4
+             HINTS "${ROCM_PATH}/lib" REQUIRED)
+list(APPEND ck_fused_attn_LINKER_LIBS hip::host hip::device "${ROCTX_LIBRARY}" -l:te_libmha_fwd.so -l:te_libmha_bwd.so)
 target_link_libraries(ck_fused_attn PUBLIC ${ck_fused_attn_LINKER_LIBS})
 target_compile_options(ck_fused_attn PRIVATE ${CK_FUSED_ATTN_COMPILE_OPTIONS})
 te_set_rocm_rpath(ck_fused_attn "$ORIGIN")
 
