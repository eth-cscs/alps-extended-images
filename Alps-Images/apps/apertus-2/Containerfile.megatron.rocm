# syntax=docker/dockerfile:1

ARG BASE_IMAGE
FROM ${BASE_IMAGE}

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ARG OCI_SOURCE="unknown"
ARG OCI_REVISION="unknown"
ARG OCI_CREATED="unknown"
ARG OCI_DESCRIPTION="unknown"
ARG CSCS_ALPS_GIT_COMMIT_SHORT="unknown"

LABEL org.opencontainers.image.source="${OCI_SOURCE}" \
      org.opencontainers.image.revision="${OCI_REVISION}" \
      org.opencontainers.image.created="${OCI_CREATED}" \
      org.opencontainers.image.description="${OCI_DESCRIPTION}" \
      com.cscs.alps.git.repo="${OCI_SOURCE}" \
      com.cscs.alps.git.commit="${OCI_REVISION}" \
      com.cscs.alps.git.commit_short="${CSCS_ALPS_GIT_COMMIT_SHORT}"

ARG APERTUS_BUILD_JOBS=8

ENV PYTHONNOUSERSITE=1 \
    PYTORCH_ROCM_ARCH=gfx942 \
    UCCL_EP_TRANSPORT=cxi \
    UCCL_SOCKET_IFNAME=hsn \
    UCCL_CXI_THREADING=safe \
    NVTE_FUSED_ATTN_CK=1 \
    NVTE_FUSED_ATTN_AOTRITON=0

COPY Alps-Images/common/package-helpers.sh /opt/alps/package-helpers.sh
COPY Alps-Images/apps/apertus-2/sources/rocm/ /opt/alps/apertus2-rocm/
COPY Alps-Images/apps/apertus-2/patches/rocm/ /opt/alps/apertus2-rocm/patches/

RUN bash /opt/alps/apertus2-rocm/install.sh system
RUN bash /opt/alps/apertus2-rocm/install.sh uccl
RUN bash /opt/alps/apertus2-rocm/install.sh transformer-engine
RUN bash /opt/alps/apertus2-rocm/install.sh training
RUN bash /opt/alps/apertus2-rocm/install.sh megatron

# Keep the compiler and headers: TE CK attention and FLA use runtime JIT.
COPY Alps-Images/apps/apertus-2/tests/rocm/ /opt/tests/apertus-2/rocm/
RUN python3 /opt/tests/apertus-2/rocm/check-stack.py --metadata-only
