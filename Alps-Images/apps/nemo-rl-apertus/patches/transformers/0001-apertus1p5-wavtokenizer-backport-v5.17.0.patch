+        vq_factor = 2 ** (len(vq_channel_multiplier) - 1)
+        self.image_seq_length = (image_size // vq_factor) ** 2  # flat H*W codes, no EOL column
+        self.audio_seq_length = -(-audio_samples // audio_hop_length)  # ceil
