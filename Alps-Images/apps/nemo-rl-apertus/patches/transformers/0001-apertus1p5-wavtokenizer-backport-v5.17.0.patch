+    def test_codes_not_degenerate(self):
+        model = self.get_model()
+        with torch.no_grad():
+            codes = model.encode(torch.randn(1, 3, 64, 64, device=torch_device))
+        self.assertGreater(codes.unique().numel(), 1)
