From e8cbfbdef5750c888eb80396535bde2e912755e7 Mon Sep 17 00:00:00 2001
From: aurianer <aurianer@cscs.ch>
Date: Fri, 9 Oct 2026 15:05:51 +0200
Subject: [PATCH 1/3] [Triton/Gluon] [JIT] [Bugfix] add support for MI300A and
 fix XCD count

Signed-off-by: aurianer <aurianer@cscs.ch>
---
 aiter/jit/utils/chip_info.py          |  3 ++-
 aiter/ops/triton/utils/device_info.py | 21 ++++++++++++++++++---
 2 files changed, 20 insertions(+), 4 deletions(-)

diff --git a/aiter/jit/utils/chip_info.py b/aiter/jit/utils/chip_info.py
index 59464a5b7..688dc9954 100644
--- a/aiter/jit/utils/chip_info.py
+++ b/aiter/jit/utils/chip_info.py
@@ -200,13 +200,14 @@ def get_asic_revision() -> int:

 # Backfill map for legacy tuned configs that predate the `gfx` column.
 # These cu_num values were only ever tuned on a single arch historically:
-#   256 -> gfx950, 80/304 -> gfx942.
+#   256 -> gfx950, 80/228/304 -> gfx942.
 # Newer archs that happen to share a cu_num (e.g. gfx1250 also reports 256)
 # are always written with their real arch by the tuner, so they never rely on
 # this backfill.
 _LEGACY_CU_NUM_TO_GFX = {
     256: "gfx950",
     80: "gfx942",
+    228: "gfx942",
     304: "gfx942",
 }

diff --git a/aiter/ops/triton/utils/device_info.py b/aiter/ops/triton/utils/device_info.py
index 3041481d3..c683ae5c8 100644
--- a/aiter/ops/triton/utils/device_info.py
+++ b/aiter/ops/triton/utils/device_info.py
@@ -22,6 +22,21 @@ def get_num_sms():
         return current_device.multi_processor_count


-def get_num_xcds():
-    # Currently, you can't query this programmatically. For gfx942/gfx950 it's 8, so we hardcode that here.
-    return 8
+# XCD count is not queryable in ROCm, but runtime architecture and CU count
+# identify supported parts. Kernels use it to keep workgroups sharing data on one L2.
+_XCDS_BY_GFX_AND_CU_NUM = {
+    ("gfx942", 304): 8,
+    ("gfx942", 228): 6,
+    ("gfx942", 80): 4,
+    ("gfx950", 256): 8,
+}
+
+
+def get_num_xcds() -> int:
+    try:
+        from aiter.jit.utils.chip_info import get_cu_num, get_gfx_runtime
+
+        part = (get_gfx_runtime(), get_cu_num())
+    except Exception:  # noqa: BLE001
+        return 8
+    return _XCDS_BY_GFX_AND_CU_NUM.get(part, 8)
