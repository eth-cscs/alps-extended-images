+# Copyright (c) 2026, NVIDIA CORPORATION. All rights reserved.
+"""Optional CPU-storage VMA policy for ATS systems (like GH200), requires Linux libnuma."""
+
+import ctypes
+import os
+
+
+class CpuMemoryBinder:
+    """Bind pageable storage to explicit NUMA nodes, not just the allocating thread.
+
+    mbind works at page granularity, so boundary pages shared with other allocations
+    receive the same policy. Pinned storage is already locked against migration.
+    """
+
+    def __init__(self, nodes):
+        class Bitmask(ctypes.Structure):
+            _fields_ = [("size", ctypes.c_ulong), ("maskp", ctypes.POINTER(ctypes.c_ulong))]
+
+        try:
+            self.lib = ctypes.CDLL("libnuma.so.1", use_errno=True)
+        except OSError as error:
+            raise RuntimeError(
+                "CPU-offload NUMA binding requires libnuma.so.1; install libnuma "
+                "or unset MCORE_CPU_OFFLOAD_NUMA_NODES to disable binding."
+            ) from error
+        self.lib.numa_parse_nodestring.argtypes = [ctypes.c_char_p]
+        self.lib.numa_parse_nodestring.restype = ctypes.POINTER(Bitmask)
+        self.lib.numa_bitmask_free.argtypes = [ctypes.POINTER(Bitmask)]
+        self.lib.numa_bitmask_free.restype = None
+        self.lib.mbind.argtypes = [
+            ctypes.c_void_p,
+            ctypes.c_ulong,
+            ctypes.c_int,
+            ctypes.POINTER(ctypes.c_ulong),
+            ctypes.c_ulong,
+            ctypes.c_uint,
+        ]
+        self.lib.mbind.restype = ctypes.c_int
+        mask = self.lib.numa_parse_nodestring(nodes.encode())
+        if not mask:
+            raise ValueError(f"Invalid MCORE_CPU_OFFLOAD_NUMA_NODES: {nodes!r}")
+        try:
+            self.maxnode = mask.contents.size
+            words = (self.maxnode + 8 * ctypes.sizeof(ctypes.c_ulong) - 1) // (
+                8 * ctypes.sizeof(ctypes.c_ulong)
+            )
+            self.mask = (ctypes.c_ulong * words)(*mask.contents.maskp[:words])
+        finally:
+            self.lib.numa_bitmask_free(mask)
+        if not any(self.mask):
+            raise ValueError("MCORE_CPU_OFFLOAD_NUMA_NODES must select at least one node")
+        self.page_size = os.sysconf("SC_PAGE_SIZE")
+
+    def bind(self, tensor):
+        if tensor.device.type != "cpu" or tensor.is_pinned():
+            return
+        storage = tensor.untyped_storage()
+        if not storage.nbytes():
+            return
+        start = storage.data_ptr() // self.page_size * self.page_size
+        end = (storage.data_ptr() + storage.nbytes() + self.page_size - 1) // self.page_size
+        # MPOL_BIND, MPOL_MF_MOVE: constrain the VMA and move existing movable pages.
+        if self.lib.mbind(start, end * self.page_size - start, 2, self.mask, self.maxnode, 2):
+            error = ctypes.get_errno()
+            raise OSError(error, f"CPU offload mbind failed: {os.strerror(error)}")
