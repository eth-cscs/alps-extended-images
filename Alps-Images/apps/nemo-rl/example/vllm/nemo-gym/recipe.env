# Asynchronous vLLM generation with the remote NeMo Gym math verifier (TDS).
CONFIG_FILE=grpo-chonk.yaml
ENTRYPOINT=examples/nemo_gym/run_grpo_nemo_gym.py
GENERATION_BACKEND=vllm
GYM_ENABLED=1
GYM_ENV=math
NEMO_PRS=(5 1)
JOB_NAME=nemo-gym-chonk
JOB_TIME=02:00:00
RUN_NAME=nemo-rl-nemo-gym-chonk
TRAIN_NODES=16
INFERENCE_NODES=8
TRAIN_GLOBAL_BATCH=128
DEFAULT_MICRO_BATCH=1
DEFAULT_NUM_PROMPTS=32
GENERATIONS_PER_PROMPT=8
DEFAULT_MAX_NUM_STEPS=2
