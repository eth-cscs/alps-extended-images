# Copy to .env beside submit.sh.

# NEMO_RL_IMAGE=registry/path/nemo-rl-cuda:your-built-tag

# Enable W&B after setting your project and credentials.
WANDB_ENABLED=false
WANDB_PROJECT=chonk-grpo

# Optional user or team namespace, run group and display name.
# WANDB_ENTITY=your-user-or-team
# WANDB_RUN_GROUP=experiment-group
# WANDB_NAME=run-name

# Keep the real key only in your private .env or submission environment.
# WANDB_API_KEY=your-api-key

# To save locally without contacting W&B, enable logging and use offline mode.
# WANDB_MODE=offline
