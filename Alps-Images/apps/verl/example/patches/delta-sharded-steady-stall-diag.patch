+def _cscs_steady_stall_diag(tag: str, first_after: float = 600.0, every: float = 300.0) -> None:
+    """[CSCS diagnostic, run 3289420] Rank-0 stall dumper for the STEADY delta sync.
+
+    The first real-gradient steady sync hung for the full 30-min NCCL timeout with rank 0
+    (the wire master) stuck between two adjacent ``dist.gather`` calls in
+    ``sparse_gather.gather_slot_entries_to_rank0`` -- i.e. inside NCCL's launch of a
+    480-peer gather-to-one -- and the flight recorder only shows that the work was never
+    enqueued, not WHERE rank 0 sits. This thread waits ``first_after`` s and then, while
+    the calling thread is still inside ``send_weights``, every ``every`` s prints all
+    Python thread stacks (faulthandler) plus a ``py-spy dump --native`` of this process
+    (C/NCCL/libfabric frames) to stderr, which Ray relays into the job log. Self-terminates
+    once ``send_weights`` returns (no cleanup hook needed). Diagnostic only; remove once
+    the stall is understood."""
+    import faulthandler
+    import os
+    import subprocess
+    import sys
+    import threading
+
+    caller_ident = threading.get_ident()
+    t0 = time.time()
+
+    def _in_send_weights() -> bool:
+        fr = sys._current_frames().get(caller_ident)
+        while fr is not None:
+            if fr.f_code.co_name == "send_weights":
+                return True
+            fr = fr.f_back
+        return False
+
+    def _run() -> None:
+        time.sleep(first_after)
+        while _in_send_weights():
+            el = time.time() - t0
+            print(
+                f"[WSYNC-STALL] {tag} rank0 pid={os.getpid()} still inside send_weights after {el:.0f}s -- "
+                "dumping all Python thread stacks (faulthandler) then py-spy --native",
+                file=sys.stderr,
+                flush=True,
+            )
+            try:
+                faulthandler.dump_traceback(file=sys.stderr, all_threads=True)
+            except Exception as e:  # noqa: BLE001
+                print(f"[WSYNC-STALL] faulthandler failed: {e}", file=sys.stderr, flush=True)
+            try:
+                for extra in (["--native"], []):
+                    out = subprocess.run(
+                        ["py-spy", "dump", "--pid", str(os.getpid()), "--nonblocking", *extra],
+                        capture_output=True,
+                        text=True,
+                        timeout=180,
+                    )
+                    print(
+                        f"[WSYNC-STALL] py-spy {' '.join(extra) or '(python only)'} rc={out.returncode}:\n"
+                        f"{out.stdout}\n{out.stderr[-3000:]}",
+                        file=sys.stderr,
+                        flush=True,
+                    )
+                    if out.returncode == 0:
+                        break
+            except Exception as e:  # noqa: BLE001
+                print(f"[WSYNC-STALL] py-spy failed: {e}", file=sys.stderr, flush=True)
+            time.sleep(every)
+        print(f"[WSYNC-STALL] {tag} send_weights finished after {time.time() - t0:.0f}s", file=sys.stderr, flush=True)
+
+    threading.Thread(target=_run, name="cscs-wsync-stall-diag", daemon=True).start()
+
+
