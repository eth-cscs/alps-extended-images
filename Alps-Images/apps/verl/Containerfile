# syntax=docker/dockerfile:1

# Special thanks to Eduard Durech for his work on the original VeRL image for Alps.

ARG BASE_IMAGE
FROM ${BASE_IMAGE}

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ARG OCI_SOURCE="unknown"
ARG OCI_REVISION="unknown"
ARG OCI_CREATED="unknown"
ARG OCI_DESCRIPTION="unknown"
ARG CSCS_ALPS_GIT_COMMIT_SHORT="unknown"

LABEL org.opencontainers.image.source="${OCI_SOURCE}" \
      org.opencontainers.image.revision="${OCI_REVISION}" \
      org.opencontainers.image.created="${OCI_CREATED}" \
      org.opencontainers.image.description="${OCI_DESCRIPTION}" \
      com.cscs.alps.git.repo="${OCI_SOURCE}" \
      com.cscs.alps.git.commit="${OCI_REVISION}" \
      com.cscs.alps.git.commit_short="${CSCS_ALPS_GIT_COMMIT_SHORT}"


# v0.9.0: adds verl/trainer/ppo/v1 (the V1 separate-async trainer) + TransferQueue integration
ARG VERL_REF="v0.9.0"

COPY Alps-Images/common/package-helpers.sh /opt/alps/package-helpers.sh

# Install dependencies for VeRL from pypi, including vLLM and SGLang.

#Note: disable vllm installation for now, as it causes issues. To re-enable consider using the ngc vllm base image.
#RUN source /opt/alps/package-helpers.sh && pip_install python vllm --extra-index-url https://download.pytorch.org/whl/cu131

# sglang pinned to 0.5.16 (was unpinned -> resolved to whatever was latest, 0.5.17/0.5.18 by
# 2026-08). 0.5.16 is the version every GLM-5.1 recipe piece is validated against and, crucially,
# the only recent sglang whose own flashinfer requirement (flashinfer_python[cu13]==0.6.14)
# matches the flashinfer pin below -- 0.5.17 wants 0.6.15.post1, 0.5.18 wants 0.6.17, so leaving
# sglang unpinned reintroduces the exact python-vs-required flashinfer skew that caused run
# 3209484's TP=32 MLA plan() hang. The verl-vs-sglang import-drift source patches
# (r3-sglang-routed-experts-import-fix, delta-sharded-localserializedtensor-import-fix) also
# target 0.5.16's module layout. Bump this + the flashinfer pin together, deliberately, tested.
RUN set -eux; \
    source /opt/alps/package-helpers.sh; \
    pip_install python "sglang[all]==0.5.16"

# Capture the exact torch + torchvision versions that sglang chose.
# sglang pins its own deps, so this pair is guaranteed ABI-compatible.
# All subsequent pip installs will be constrained to these versions so no
# step can silently swap the C extension out from under us.
RUN pip freeze | grep -E "^torch(vision)?==" | tee /tmp/torch_constraints.txt && \
    python -c "import torchvision, torch; print('After sglang — torch:', torch.__version__, '/ torchvision:', torchvision.__version__)"

RUN set -eux; \
    source /opt/alps/package-helpers.sh; \
    pip_install python flash-attn --no-build-isolation

RUN set -eux; \
    source /opt/alps/package-helpers.sh; \
    pip_install python flash-attn --no-build-isolation

# Install dependencies for VeRL from source, including flashinfer, flash-attention, torch_memory_saver, XIELU

ENV SRC_DIR=/workspace/src \
    WHL_DIR=/workspace/src/wheels

WORKDIR ${SRC_DIR}


WORKDIR /workspace

RUN rm -rf ${SRC_DIR}

RUN git clone --branch ${VERL_REF} --depth 1 https://github.com/verl-project/verl
RUN set -eux; \
    source /opt/alps/package-helpers.sh; \
    cd verl; \
    pip_install python --no-deps -e ".[sglang]"

RUN set -eux; \
    source /opt/alps/package-helpers.sh; \
    pip_install python -U "ray[data,train,tune,serve]"

RUN set -eux; \
    source /opt/alps/package-helpers.sh; \
    pip_install python "tensordict==0.10.0" omegaconf hydra-core codetiming peft pylatexenc wandb TransferQueue==0.1.7
RUN pip uninstall kernels -y --break-system-packages

RUN set -eux; \
    source /opt/alps/package-helpers.sh; \
    pip_install python cupy-cuda13x
RUN set -eux; \
    source /opt/alps/package-helpers.sh; \
    pip_install python cachetools

# Add Megatron

RUN pip install "PyYAML>=6.0.2" --ignore-installed

# megatron-core[dev,mlm] (pulled by megatron-bridge) requires fast-hadamard-transform,
# a CUDA extension with no aarch64 wheel and a broken source tarball (missing csrc/*.cpp).
# Pin it to a local no-op stub via PEP 508 direct reference so pip's resolver satisfies
# the transitive dependency without ever attempting to download or compile it.
RUN mkdir -p /tmp/fht && \
    printf '[project]\nname = "fast-hadamard-transform"\nversion = "1.1.0"\n' > /tmp/fht/pyproject.toml

RUN pip install -c /tmp/torch_constraints.txt \
        "megatron-bridge==0.6.1" "megatron-core==0.19.0" "nvidia-resiliency-ext>=0.6.0" \
        "fast-hadamard-transform @ file:///tmp/fht"
RUN python -c "import torchvision, torch; print('After megatron-bridge — torch:', torch.__version__, '/ torchvision:', torchvision.__version__)"

RUN pip install -c /tmp/torch_constraints.txt nvidia-modelopt[hf]
RUN python -c "import torchvision, torch; print('After nvidia-modelopt — torch:', torch.__version__, '/ torchvision:', torchvision.__version__)"

# megatron-bridges mlflow/comet-ml deps upgrade opentelemetry-exporter-prometheus
# to 0.64b0 which requires opentelemetry-sdk~=1.43.0, but the SDK stays at 1.33.1
# → Ray dashboard crashes with AttributeError → GCS never starts → all workers fail.
# Fix: upgrade the SDK to match the already-upgraded exporters.
RUN pip install -c /tmp/torch_constraints.txt "opentelemetry-sdk>=1.43.0"

# Restore sglang-compatible versions that megatron-bridge overwrites.
# The constraints file prevents megatron-bridge/timm/transformers from
# silently changing the torch or torchvision ABI.
RUN pip install -c /tmp/torch_constraints.txt "transformers==5.8.1" "timm==1.0.16"
RUN python -c "import torchvision, torch; print('After transformers/timm — torch:', torch.__version__, '/ torchvision:', torchvision.__version__)"

# flashinfer 0.6.12 -> 0.6.14: sglang 0.5.16 pins flashinfer_python[cu13]==0.6.14; the stale
# 0.6.12 (from 2026-07-27, predates the sglang[all] bump) hung sglang's MLA/DSA decode plan()
# at TP=32 (run 3209484, ~step 13). flashinfer 0.6.14 hard-raises at import unless flashinfer_cubin
# is the *exact* same version (run 3214410). flashinfer_cubin/jit-cache are NOT fully published to
# PyPI (PyPI stops at cubin 0.6.13) -- the real distribution channel is https://flashinfer.ai/whl
# (GitHub release assets), per flashinfer's install docs; flashinfer_cubin-0.6.14 lives there.
# Install the matched 0.6.14 pair from that index -> clean AOT, no version-check bypass.
RUN pip install -c /tmp/torch_constraints.txt --extra-index-url https://flashinfer.ai/whl \
        "flashinfer_cubin==0.6.14" "flashinfer_python[cu13]==0.6.14"

# transformer-engine rebuild — MUST be last (after every step that can move torch).
# sglang[all] pins torch to 2.11.0, which is newer than the NGC base image's bundled torch, so
# the base's prebuilt transformer_engine_torch C++ bindings fail to load against it
# (`undefined symbol: _ZN3c104impl3cow23materialize_cow_storageERNS_11StorageImplE`, run 3235127)
# -> `import megatron.core` fails cluster-wide -> verl has no `megatron` engine backend
# -> AssertionError: Unknown backend: megatron. transformer_engine_torch ships only as an sdist,
# so this is a source build against the now-final torch (uses the base image's CUDA toolkit +
# ninja; ~20-40 min). `core_cu13` matches this image's CUDA 13 stack and megatron-core 0.19's own
# `te` extra spec. The second RUN is a hard build-time gate: if TE / megatron.core still do not
# import, the image build FAILS here instead of shipping another broken image.
RUN pip install -c /tmp/torch_constraints.txt --no-cache-dir --no-build-isolation --force-reinstall \
        "transformer-engine[core-cu13,pytorch]"
RUN python -c "import importlib.metadata as m, torch, transformer_engine.pytorch, megatron.core; print('OK torch', torch.__version__, '| transformer-engine', m.version('transformer-engine'), '| megatron.core imports')"

# Tests shipped with the image
COPY Alps-Images/apps/verl/tests/ /opt/tests/verl/
RUN find /opt/tests/verl -name "*.sh" -exec chmod a+x {} \; && \
    chmod -R a+rX /opt/tests/verl
