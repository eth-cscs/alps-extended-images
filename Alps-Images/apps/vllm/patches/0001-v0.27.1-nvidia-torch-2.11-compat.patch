+namespace {
+// Torch 2.11 stable::from_blob no longer accepts deleters in this path.
+// Keep UVA backing storage process-lifetime to avoid dangling CUDA views. This
+// intentionally leaks one entry per call and is acceptable only as a narrow
+// compatibility shim for the pinned vLLM ref.
+struct UvaLifetimeRegistry {
+  std::mutex mutex;
+  std::vector<torch::stable::Tensor> cpu_tensors;
+  std::vector<void*> mapped_host_allocations;
+};
+
+UvaLifetimeRegistry& uva_lifetime_registry() {
+  static auto* registry = new UvaLifetimeRegistry();
+  return *registry;
+}
+
+struct CudaHostDeleter {
+  void operator()(void* ptr) const {
+    if (ptr != nullptr) {
+      cudaFreeHost(ptr);
+    }
+  }
+};
+}  // namespace
 
