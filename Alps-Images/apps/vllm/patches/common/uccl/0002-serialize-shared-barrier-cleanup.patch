From 2a9883eb0bf5f94977b666c6c22388e72398cbe4 Mon Sep 17 00:00:00 2001
From: CSCS Alps Images <noreply@cscs.ch>
Date: Wed, 30 Sep 2026 00:00:00 +0000
Subject: [PATCH] ep: serialize stale shared-barrier cleanup

Every rank currently sweeps the same node-local UCCL barrier files before
constructing its proxies. One rank can unlink a barrier after another rank
has created it, splitting the local ranks across different shared-memory
objects and crashing the proxy runtime nondeterministically.

Detect the node topology first, let one rank per node remove stale barriers,
and synchronize the group before any proxy creates new barriers.
---
 ep/bench/utils.py | 25 +++++++++++++++----------
 1 file changed, 15 insertions(+), 10 deletions(-)

diff --git a/ep/bench/utils.py b/ep/bench/utils.py
--- a/ep/bench/utils.py
+++ b/ep/bench/utils.py
@@ -577,18 +577,6 @@ def initialize_uccl(
     use_normal_mode=False,
     rdma_buffer_is_host_allocated=False,
 ):
-    # Only sweep barriers belonging to OUR mode so we don't stomp on a
-    # coexisting Buffer of the other mode in the same process. The C++
-    # shm name format is `/uccl_barrier_<ip>_uid<uid>_<ht|ll>_th<idx>`,
-    # where `ht` = high-throughput (use_normal_mode=True) and `ll` =
-    # low-latency.
-    try:
-        mode_token = "_ht_" if use_normal_mode else "_ll_"
-        for shm_file in glob.glob(f"/dev/shm/uccl_barrier_*{mode_token}*"):
-            os.remove(shm_file)
-    except Exception:
-        pass
-
     (
         local_rank,
         node_local_rank,
@@ -597,6 +585,22 @@ def initialize_uccl(
         num_nodes,
         detected_is_intranode,
     ) = detect_group_topology(group)
+
+    # Only one rank per node may sweep the node-local barriers. Otherwise a
+    # rank can unlink a barrier that another rank has just created. Keep the
+    # mode filter so coexisting high-throughput and low-latency buffers do not
+    # remove each other's barriers.
+    if node_local_rank == 0:
+        try:
+            mode_token = "_ht_" if use_normal_mode else "_ll_"
+            for shm_file in glob.glob(
+                f"/dev/shm/uccl_barrier_*{mode_token}*"
+            ):
+                os.remove(shm_file)
+        except Exception:
+            pass
+    dist.barrier(group)
+
     if is_intranode is None:
         is_intranode = detected_is_intranode
     elif is_intranode and not detected_is_intranode:
