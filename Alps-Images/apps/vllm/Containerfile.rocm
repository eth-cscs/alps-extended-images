# syntax=docker/dockerfile:1

ARG BASE_IMAGE
FROM ${BASE_IMAGE}

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ARG OCI_SOURCE="unknown"
ARG OCI_REVISION="unknown"
ARG OCI_CREATED="unknown"
ARG OCI_DESCRIPTION="unknown"
ARG CSCS_ALPS_GIT_COMMIT_SHORT="unknown"

LABEL org.opencontainers.image.source="${OCI_SOURCE}" \
      org.opencontainers.image.revision="${OCI_REVISION}" \
      org.opencontainers.image.created="${OCI_CREATED}" \
      org.opencontainers.image.description="${OCI_DESCRIPTION}" \
      com.cscs.alps.git.repo="${OCI_SOURCE}" \
      com.cscs.alps.git.commit="${OCI_REVISION}" \
      com.cscs.alps.git.commit_short="${CSCS_ALPS_GIT_COMMIT_SHORT}"

ARG VLLM_REPO="https://github.com/vllm-project/vllm.git"
ARG VLLM_REF="ced6857afa0ea7b2e3f0846a62e1394e90f15607"
ARG VLLM_VERSION_OVERRIDE="0.30.0"
ARG AITER_REPO="https://github.com/ROCm/aiter.git"
ARG AITER_REF="v0.1.21.post2"
ARG AITER_COMMIT="2e38b2405bd688fd2d8e9fea9e7ba8f3eb9abee9"
ARG UCCL_REPO="https://github.com/uccl-project/uccl.git"
ARG UCCL_COMMIT="e22a3e8fcd636f7efbbd90900458087a41ff73ce"
ARG UCCL_NANOBIND_VERSION="3.0.1"
ARG UCCL_NUM_LOCAL_GPUS="4"
ARG VLLM_TARGET_DEVICE="rocm"
# MI300A and MI300X share gfx942. Keep vLLM and AITER single-architecture.
ARG PYTORCH_ROCM_ARCH="gfx942"
ARG MAX_JOBS="32"
LABEL org.opencontainers.image.uccl.revision="${UCCL_COMMIT}" \
      org.opencontainers.image.aiter.revision="${AITER_COMMIT}"

ENV VLLM_TARGET_DEVICE="${VLLM_TARGET_DEVICE}" \
    PYTORCH_ROCM_ARCH="${PYTORCH_ROCM_ARCH}" \
    GPU_ARCHS="${PYTORCH_ROCM_ARCH}" \
    MAX_JOBS="${MAX_JOBS}" \
    CMAKE_BUILD_PARALLEL_LEVEL="${MAX_JOBS}" \
    PYTHONNOUSERSITE="1" \
    LIBRARY_PATH="/opt/rocm/lib:/opt/rocm/lib64" \
    TVM_FFI_CACHE_DIR="/opt/alps/tvm-ffi" \
    UCCL_EP_TRANSPORT="cxi" \
    UCCL_SOCKET_IFNAME="hsn"

COPY Alps-Images/common/package-helpers.sh /opt/alps/package-helpers.sh

COPY Alps-Images/apps/vllm/patches/ /opt/alps-vllm-patches/

RUN set -eux; \
    source /opt/alps/package-helpers.sh; \
    mkdir -p /opt/alps; \
    python -c 'import importlib.metadata as m; names = ("torch", "triton"); installed = {d.metadata["Name"].lower(): d.version for d in m.distributions() if d.metadata["Name"]}; missing = [n for n in names if n not in installed]; assert not missing, f"missing base packages: {missing}"; print("\n".join(f"{n}=={installed[n]}" for n in names))' > /opt/alps/vllm-base-pins.txt; \
    export PIP_CONSTRAINT=/opt/alps/vllm-base-pins.txt; \
    cat "${PIP_CONSTRAINT}"; \
    vllm_apt_build_deps=( \
      build-essential \
      cargo \
      cmake \
      curl \
      git \
      libibverbs-dev \
      libnl-3-dev \
      libnl-route-3-dev \
      libnuma-dev \
      ninja-build \
      pkg-config \
      rustc \
      python3-dev \
    ); \
    vllm_apt_install_packages=(ca-certificates libibverbs1 "${vllm_apt_build_deps[@]}"); \
    snapshot_apt_packages /tmp/vllm-apt-before.txt; \
    apt_get update; \
    apt_get install -y --no-install-recommends "${vllm_apt_install_packages[@]}"; \
    rm -rf /var/lib/apt/lists/*; \
    source /opt/alps/env/alps-rocm-build.env; \
    source /opt/alps/install-alps-hpc-stack.sh; \
    source /opt/alps/install-alps-rocm-components.sh; \
    ROCM_BUILD_PREFIX="${ROCM_BUILD_PREFIX:?ROCM_BUILD_PREFIX missing from alps-rocm-build.env}"; \
    test -d "${ROCM_BUILD_PREFIX}"; \
    rocm_ldconfig_file=/etc/ld.so.conf.d/99-alps-vllm-rocm-sdk.conf; \
    : > "${rocm_ldconfig_file}"; \
    while IFS= read -r rocm_lib_dir; do \
      printf '%s\n' "${rocm_lib_dir}" >> "${rocm_ldconfig_file}"; \
    done < <(rocm_sdk_ldconfig_dirs); \
    for rocm_root in $(rocm_sdk_prefix_candidates); do \
      test -d "${rocm_root}" || continue; \
      while IFS= read -r rocm_lib_dir; do \
        printf '%s\n' "${rocm_lib_dir}" >> "${rocm_ldconfig_file}"; \
      done < <(find "${rocm_root}" -type f -name 'librocm-openblas.so*' -printf '%h\n' | sort -u); \
    done; \
    sort -u "${rocm_ldconfig_file}" -o "${rocm_ldconfig_file}"; \
    export ROCM_HOME="${ROCM_BUILD_PREFIX}" ROCM_PATH="${ROCM_BUILD_PREFIX}" HIP_PATH="${ROCM_BUILD_PREFIX}"; \
    export PATH="${ROCM_BUILD_PREFIX}/bin:${ROCM_BUILD_PREFIX}/llvm/bin:${PATH}"; \
    rocm_libdir="${ROCM_BUILD_PREFIX}/lib64"; \
    test -d "${rocm_libdir}" || rocm_libdir="${ROCM_BUILD_PREFIX}/lib"; \
    export LD_LIBRARY_PATH="${rocm_libdir}:${LD_LIBRARY_PATH:-}"; \
    pip_install python --no-cache-dir --upgrade \
      'cmake<4' \
      Cython \
      ninja \
      numba \
      pybind11 \
      scipy \
      'huggingface-hub[cli]' \
      "nanobind==${UCCL_NANOBIND_VERSION}" \
      'setuptools>=77.0.3,<80.0.0' \
      setuptools-rust \
      setuptools-scm \
      wheel; \
    rm -rf /opt/aiter /tmp/aiter-dist; \
    git clone --depth=1 --branch "${AITER_REF}" --recurse-submodules --shallow-submodules \
      "${AITER_REPO}" /opt/aiter; \
    test "$(git -C /opt/aiter rev-parse HEAD)" = "${AITER_COMMIT}"; \
    cd /opt/aiter; \
    pip_install python --no-cache-dir -r requirements.txt; \
    mkdir -p /tmp/aiter-dist; \
    echo "Building AITER without multi-architecture AOT; runtime JIT target: ${PYTORCH_ROCM_ARCH}"; \
    env -u ROCM_PATH -u HIP_PATH \
      PREBUILD_KERNELS=0 \
      AITER_USE_SYSTEM_TRITON=1 \
      GPU_ARCHS="${PYTORCH_ROCM_ARCH}" \
      MAX_JOBS="${MAX_JOBS}" \
      python setup.py bdist_wheel --dist-dir /tmp/aiter-dist; \
    pip_install python --no-cache-dir --no-deps /tmp/aiter-dist/*.whl; \
    rm -rf /opt/uccl /tmp/uccl-ep-build; \
    git init -q /opt/uccl; \
    git -C /opt/uccl remote add origin "${UCCL_REPO}"; \
    git -C /opt/uccl fetch --depth=1 origin "${UCCL_COMMIT}"; \
    git -C /opt/uccl checkout -q --detach FETCH_HEAD; \
    test "$(git -C /opt/uccl rev-parse HEAD)" = "${UCCL_COMMIT}"; \
    shopt -s nullglob; uccl_patch_files=(/opt/alps-vllm-patches/uccl/*.patch); shopt -u nullglob; \
    for patch_file in "${uccl_patch_files[@]}"; do \
      echo "Applying UCCL patch: ${patch_file}"; \
      git -C /opt/uccl apply --check "${patch_file}"; \
      git -C /opt/uccl apply "${patch_file}"; \
    done; \
    uccl_site_packages="$(python -c 'import site; print(site.getsitepackages()[0])')"; \
    cd /opt/uccl/ep; \
    LIBFABRIC_HOME=/usr \
      USE_LIBFABRIC_CXI=1 \
      PER_EXPERT_BATCHING=1 \
      NUM_MAX_NVL_PEERS="${UCCL_NUM_LOCAL_GPUS}" \
      MAX_NUM_GPUS="${UCCL_NUM_LOCAL_GPUS}" \
      PYTORCH_ROCM_ARCH="${PYTORCH_ROCM_ARCH}" \
      INSTALL_DIR="${uccl_site_packages}/uccl" \
      python setup.py build --build-base /tmp/uccl-ep-build install; \
    printf '%s\n' '"""UCCL expert-parallel extension."""' > "${uccl_site_packages}/uccl/__init__.py"; \
    cp -LR /opt/uccl/ep/deep_ep_wrapper/deep_ep "${uccl_site_packages}/deep_ep"; \
    rm -rf /opt/vllm; \
    git clone --recursive "${VLLM_REPO}" /opt/vllm; \
    cd /opt/vllm; \
    git checkout -q "${VLLM_REF}"; \
    git submodule update --init --recursive; \
    if [ -z "${VLLM_VERSION_OVERRIDE}" ] && [[ "${VLLM_REF}" == v[0-9]* ]]; then \
      export VLLM_VERSION_OVERRIDE="${VLLM_REF#v}"; \
    fi; \
    shopt -s nullglob; \
    vllm_patch_files=(/opt/alps-vllm-patches/*.patch /opt/alps-vllm-patches/vllm/*.patch); \
    shopt -u nullglob; \
    for patch_file in "${vllm_patch_files[@]}"; do \
      echo "Applying vLLM patch: ${patch_file}"; \
      git apply --check "${patch_file}"; \
      git apply "${patch_file}"; \
    done; \
    pip_install python --no-cache-dir -r requirements/rocm.txt; \
    # clang 23 in the ROCm 10 wheel SDK treats any ROCM_PATH/HIP_PATH env var as an
    # explicit --rocm-path and then mis-detects the HIP language (__host__ rejected in
    # -x hip compiles), so the build drops both. ROCM_HOME is kept: torch uses it to
    # pass -DROCM_PATH to the cmake configure so enable_language(HIP) finds the
    # hip-lang package in the Alps compat layout at /opt/rocm.
    rm -rf /tmp/vllm-dist; \
    mkdir -p /tmp/vllm-dist; \
    env -u ROCM_PATH -u HIP_PATH \
      python setup.py bdist_wheel --dist-dir /tmp/vllm-dist; \
    pip_install python --no-cache-dir --no-deps /tmp/vllm-dist/*.whl; \
    pip_install python --no-cache-dir "ray[default]" sentencepiece tiktoken; \
    tvm_ffi_torch_version="$(python -c 'import torch; print("".join(torch.__version__.split(".")[:2]))')"; \
    tvm_ffi_addon="${TVM_FFI_CACHE_DIR}/libtorch_c_dlpack_addon_torch${tvm_ffi_torch_version}-rocm.so"; \
    TVM_FFI_DISABLE_TORCH_C_DLPACK=1 \
      python -m tvm_ffi.utils._build_optional_torch_c_dlpack \
        --output-dir "${TVM_FFI_CACHE_DIR}" \
        --libname "$(basename "${tvm_ffi_addon}")" \
        --build-with-rocm; \
    test -s "${tvm_ffi_addon}"; \
    chmod -R a+rX "${TVM_FFI_CACHE_DIR}"; \
    torch_lib_dir="$(python -c 'import os, torch; print(os.path.join(os.path.dirname(torch.__file__), "lib"))')"; \
    test -d "${torch_lib_dir}"; \
    printf '%s\n' "${torch_lib_dir}" > /etc/ld.so.conf.d/99-alps-vllm-torch.conf; \
    ldconfig; \
    APT_CLEANUP_HOLD_PACKAGES=libibverbs1 \
      cleanup_new_apt_build_deps /tmp/vllm-apt-before.txt "${vllm_apt_build_deps[@]}"; \
    rm -rf /opt/aiter /tmp/aiter-dist /opt/uccl /tmp/uccl-ep-build /opt/vllm /tmp/vllm-dist /tmp/vllm-apt-before.txt /root/.cache/pip

RUN set -eux; \
    while IFS= read -r pin; do \
      package="${pin%%==*}"; \
      expected="${pin#*==}"; \
      actual="$(python -c 'import importlib.metadata as m, sys; print(m.version(sys.argv[1]))' "${package}")"; \
      test "${actual}" = "${expected}"; \
    done < /opt/alps/vllm-base-pins.txt; \
    vllm_version="$(python -c 'import importlib.metadata as m; print(m.version("vllm"))')"; \
    printf 'vllm=%s\n' "${vllm_version}"; \
    expected_vllm_version="${VLLM_VERSION_OVERRIDE}"; \
    if [ -z "${expected_vllm_version}" ] && [[ "${VLLM_REF}" == v[0-9]* ]]; then expected_vllm_version="${VLLM_REF#v}"; fi; \
    if [ -n "${expected_vllm_version}" ]; then test "${vllm_version}" = "${expected_vllm_version}"; fi; \
    python -c 'import importlib.metadata as m; print("amd-aiter={}".format(m.version("amd-aiter")))'; \
    python -c 'import torch; print("torch={} hip={}".format(torch.__version__, torch.version.hip))'; \
    python -c 'import uccl.ep; import deep_ep; print("uccl.ep={} deep_ep={}".format(uccl.ep.__file__, deep_ep.__file__))'; \
    python -c 'import os; path = os.path.join(os.environ["TVM_FFI_CACHE_DIR"], "libtorch_c_dlpack_addon_torch{}-rocm.so".format("".join(__import__("torch").__version__.split(".")[:2]))); assert os.path.isfile(path), path; print("tvm_ffi_rocm_addon={}".format(path))'; \
    python -m pip check || echo "WARN: inconsistent pip dependency resolution (see above)"; \
    vllm_dir="$(python -c 'import importlib.util; spec = importlib.util.find_spec("vllm"); print(spec.submodule_search_locations[0] if spec else "")')"; \
    if [ -z "${vllm_dir}" ]; then \
      echo "FATAL: vllm is not importable by the runtime python" >&2; \
      exit 1; \
    fi; \
    missing="$(find "${vllm_dir}" -name '*.so' \
                 -exec ldd {} + 2>/dev/null | grep 'not found' || true)"; \
    if [ -n "${missing}" ]; then \
      echo "FATAL: vLLM native extensions have unresolved dependencies:" >&2; \
      echo "${missing}" >&2; \
      exit 1; \
    fi; \
    uccl_ep_so="$(python -c 'import uccl.ep; print(uccl.ep.__file__)')"; \
    missing="$(ldd "${uccl_ep_so}" 2>/dev/null | grep 'not found' || true)"; \
    if [ -n "${missing}" ]; then \
      echo "FATAL: UCCL-EP has unresolved dependencies:" >&2; \
      echo "${missing}" >&2; \
      exit 1; \
    fi; \
    if dpkg-query -W -f='${db:Status-Abbrev}' libibverbs-dev 2>/dev/null | grep -q '^ii '; then \
      echo "FATAL: libibverbs-dev remains installed after the UCCL-EP build" >&2; \
      exit 1; \
    fi; \
    echo "OK: vLLM ROCm smoke checks passed"

# Mooncake transfer engine (CXI)
COPY Alps-Images/apps/vllm/sources/install-mooncake.sh /opt/alps/install-mooncake.sh
COPY Alps-Images/apps/vllm/patches/mooncake /opt/alps/mooncake-patches

RUN set -eux; \
    chmod +x /opt/alps/install-mooncake.sh; \
    /opt/alps/install-mooncake.sh rocm

# Tests shipped with the image
COPY Alps-Images/apps/vllm/tests/ /opt/tests/vllm/
RUN chmod -R a+rX /opt/tests/vllm
