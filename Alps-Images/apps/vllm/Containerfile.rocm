# syntax=docker/dockerfile:1

ARG BASE_IMAGE
FROM ${BASE_IMAGE}

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ARG OCI_SOURCE="unknown"
ARG OCI_REVISION="unknown"
ARG OCI_CREATED="unknown"
ARG OCI_DESCRIPTION="unknown"
ARG CSCS_ALPS_GIT_COMMIT_SHORT="unknown"

LABEL org.opencontainers.image.source="${OCI_SOURCE}" \
      org.opencontainers.image.revision="${OCI_REVISION}" \
      org.opencontainers.image.created="${OCI_CREATED}" \
      org.opencontainers.image.description="${OCI_DESCRIPTION}" \
      com.cscs.alps.git.repo="${OCI_SOURCE}" \
      com.cscs.alps.git.commit="${OCI_REVISION}" \
      com.cscs.alps.git.commit_short="${CSCS_ALPS_GIT_COMMIT_SHORT}"

ARG VLLM_REPO="https://github.com/vllm-project/vllm.git"
ARG VLLM_REF="v0.29.0"
ARG AITER_REPO="https://github.com/ROCm/aiter.git"
ARG AITER_REF="v0.1.19"
ARG AITER_COMMIT="31350226161346314b3d8882c8085bd31dce6a34"
ARG VLLM_TARGET_DEVICE="rocm"
# MI300A and MI300X share gfx942. Keep vLLM and AITER single-architecture.
ARG PYTORCH_ROCM_ARCH="gfx942"
ARG MAX_JOBS="32"

ENV VLLM_TARGET_DEVICE="${VLLM_TARGET_DEVICE}" \
    PYTORCH_ROCM_ARCH="${PYTORCH_ROCM_ARCH}" \
    GPU_ARCHS="${PYTORCH_ROCM_ARCH}" \
    MAX_JOBS="${MAX_JOBS}" \
    CMAKE_BUILD_PARALLEL_LEVEL="${MAX_JOBS}" \
    LIBRARY_PATH="/opt/rocm/lib:/opt/rocm/lib64"

COPY Alps-Images/common/package-helpers.sh /opt/alps/package-helpers.sh

COPY Alps-Images/apps/vllm/patches/ /opt/alps-vllm-patches/

RUN set -eux; \
    source /opt/alps/package-helpers.sh; \
    vllm_apt_build_deps=( \
      build-essential \
      cargo \
      cmake \
      curl \
      git \
      ninja-build \
      pkg-config \
      rustc \
      python3-dev \
    ); \
    vllm_apt_install_packages=(ca-certificates "${vllm_apt_build_deps[@]}"); \
    snapshot_apt_packages /tmp/vllm-apt-before.txt; \
    apt_get update; \
    apt_get install -y --no-install-recommends "${vllm_apt_install_packages[@]}"; \
    rm -rf /var/lib/apt/lists/*; \
    source /opt/alps/env/alps-rocm-build.env; \
    source /opt/alps/install-alps-hpc-stack.sh; \
    source /opt/alps/install-alps-rocm-components.sh; \
    ROCM_BUILD_PREFIX="${ROCM_BUILD_PREFIX:?ROCM_BUILD_PREFIX missing from alps-rocm-build.env}"; \
    test -d "${ROCM_BUILD_PREFIX}"; \
    rocm_ldconfig_file=/etc/ld.so.conf.d/99-alps-vllm-rocm-sdk.conf; \
    : > "${rocm_ldconfig_file}"; \
    while IFS= read -r rocm_lib_dir; do \
      printf '%s\n' "${rocm_lib_dir}" >> "${rocm_ldconfig_file}"; \
    done < <(rocm_sdk_ldconfig_dirs); \
    for rocm_root in $(rocm_sdk_prefix_candidates); do \
      test -d "${rocm_root}" || continue; \
      while IFS= read -r rocm_lib_dir; do \
        printf '%s\n' "${rocm_lib_dir}" >> "${rocm_ldconfig_file}"; \
      done < <(find "${rocm_root}" -type f -name 'librocm-openblas.so*' -printf '%h\n' | sort -u); \
    done; \
    sort -u "${rocm_ldconfig_file}" -o "${rocm_ldconfig_file}"; \
    export ROCM_HOME="${ROCM_BUILD_PREFIX}" ROCM_PATH="${ROCM_BUILD_PREFIX}" HIP_PATH="${ROCM_BUILD_PREFIX}"; \
    export PATH="${ROCM_BUILD_PREFIX}/bin:${ROCM_BUILD_PREFIX}/llvm/bin:${PATH}"; \
    rocm_libdir="${ROCM_BUILD_PREFIX}/lib64"; \
    test -d "${rocm_libdir}" || rocm_libdir="${ROCM_BUILD_PREFIX}/lib"; \
    export LD_LIBRARY_PATH="${rocm_libdir}:${LD_LIBRARY_PATH:-}"; \
    pip_install python --no-cache-dir --upgrade \
      'cmake<4' \
      Cython \
      ninja \
      numba \
      pybind11 \
      scipy \
      'huggingface-hub[cli]' \
      'setuptools>=77.0.3,<80.0.0' \
      setuptools-rust \
      setuptools-scm \
      wheel; \
    rm -rf /opt/aiter /tmp/aiter-dist; \
    git clone --depth=1 --branch "${AITER_REF}" --recurse-submodules --shallow-submodules \
      "${AITER_REPO}" /opt/aiter; \
    test "$(git -C /opt/aiter rev-parse HEAD)" = "${AITER_COMMIT}"; \
    cd /opt/aiter; \
    pip_install python --no-cache-dir -r requirements.txt; \
    mkdir -p /tmp/aiter-dist; \
    echo "Building AITER without multi-architecture AOT; runtime JIT target: ${PYTORCH_ROCM_ARCH}"; \
    env -u ROCM_PATH -u HIP_PATH \
      PREBUILD_KERNELS=0 \
      AITER_USE_SYSTEM_TRITON=1 \
      GPU_ARCHS="${PYTORCH_ROCM_ARCH}" \
      MAX_JOBS="${MAX_JOBS}" \
      python setup.py bdist_wheel --dist-dir /tmp/aiter-dist; \
    pip_install python --no-cache-dir --no-deps /tmp/aiter-dist/*.whl; \
    rm -rf /opt/vllm; \
    git clone --recursive "${VLLM_REPO}" /opt/vllm; \
    cd /opt/vllm; \
    git checkout -q "${VLLM_REF}"; \
    git submodule update --init --recursive; \
    shopt -s nullglob; vllm_patch_files=(/opt/alps-vllm-patches/*.patch); shopt -u nullglob; \
    for patch_file in "${vllm_patch_files[@]}"; do \
      echo "Applying vLLM patch: ${patch_file}"; \
      git apply --check "${patch_file}"; \
      git apply "${patch_file}"; \
    done; \
    pip_install python --no-cache-dir -r requirements/rocm.txt; \
    # clang 23 in the ROCm 10 wheel SDK treats any ROCM_PATH/HIP_PATH env var as an
    # explicit --rocm-path and then mis-detects the HIP language (__host__ rejected in
    # -x hip compiles), so the build drops both. ROCM_HOME is kept: torch uses it to
    # pass -DROCM_PATH to the cmake configure so enable_language(HIP) finds the
    # hip-lang package in the Alps compat layout at /opt/rocm.
    env -u ROCM_PATH -u HIP_PATH python setup.py develop; \
    pip_install python --no-cache-dir "ray[default]" sentencepiece tiktoken; \
    torch_lib_dir="$(python -c 'import os, torch; print(os.path.join(os.path.dirname(torch.__file__), "lib"))')"; \
    test -d "${torch_lib_dir}"; \
    printf '%s\n' "${torch_lib_dir}" > /etc/ld.so.conf.d/99-alps-vllm-torch.conf; \
    ldconfig; \
    cleanup_new_apt_build_deps /tmp/vllm-apt-before.txt "${vllm_apt_build_deps[@]}"; \
    rm -rf /opt/aiter /tmp/aiter-dist /tmp/vllm-apt-before.txt /root/.cache/pip

RUN set -eux; \
    python -c 'import importlib.metadata as m; print("amd-aiter={}".format(m.version("amd-aiter")))'; \
    python -c 'import torch; print("torch={} hip={}".format(torch.__version__, torch.version.hip))'; \
    python -m pip check || echo "WARN: inconsistent pip dependency resolution (see above)"; \
    vllm_dir="$(python -c 'import importlib.util; spec = importlib.util.find_spec("vllm"); print(spec.submodule_search_locations[0] if spec else "")')"; \
    if [ -z "${vllm_dir}" ]; then \
      echo "FATAL: vllm is not importable by the runtime python" >&2; \
      exit 1; \
    fi; \
    missing="$(find "${vllm_dir}" -name '*.so' \
                 -exec ldd {} + 2>/dev/null | grep 'not found' || true)"; \
    if [ -n "${missing}" ]; then \
      echo "FATAL: vLLM native extensions have unresolved dependencies:" >&2; \
      echo "${missing}" >&2; \
      exit 1; \
    fi; \
    echo "OK: vLLM ROCm smoke checks passed"

# Tests shipped with the image
COPY Alps-Images/apps/vllm/tests/ /opt/tests/vllm/
RUN chmod -R a+rX /opt/tests/vllm
