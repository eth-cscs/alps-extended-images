# syntax=docker/dockerfile:1

ARG BASE_IMAGE
FROM ${BASE_IMAGE}

SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ARG VLLM_TARGET_DEVICE="cuda"
ENV VLLM_TARGET_DEVICE="${VLLM_TARGET_DEVICE}" \
    PYTHONNOUSERSITE="1" \
    CCACHE_NOHASHDIR="true" \
    UCCL_EP_TRANSPORT="cxi" \
    UCCL_SOCKET_IFNAME="hsn"

COPY Alps-Images/common/package-helpers.sh /opt/alps/package-helpers.sh
COPY Alps-Images/apps/vllm/sources/build-cuda-env.sh /opt/alps/vllm-build-env.sh

# Shared Python build tools are cached independently of component pins/patches.
RUN set -eux; \
    source /opt/alps/vllm-build-env.sh; \
    mkdir -p /opt/alps; \
    python -c 'import importlib.metadata as m; names = ("torch", "torchvision", "torchaudio", "triton"); named = ((d.metadata.get("Name"), d.version) for d in m.distributions()); installed = {name.lower(): version for name, version in named if isinstance(name, str) and name}; missing = [n for n in ("torch", "triton") if n not in installed]; assert not missing, f"missing base packages: {missing}"; print("\n".join(f"{n}=={installed[n]}" for n in names if n in installed))' > /opt/alps/vllm-base-pins.txt; \
    vllm_build_begin; \
    cat "${PIP_CONSTRAINT}"; \
    pip_install python --no-cache-dir --upgrade \
      build \
      jinja2 \
      'packaging<=25.0' \
      'setuptools>=77.0.3,<81.0.0' \
      setuptools-rust \
      setuptools-scm; \
    vllm_build_end

ARG VLLM_CUDA_ARCH_LIST="9.0"
ARG VLLM_TORCH_CUDA_ARCH_LIST="9.0"
# Alps CI builders reserve 400 GiB; smaller builders can lower both build args.
ARG MAX_JOBS="64"
ARG NVCC_THREADS="4"
ENV CUDA_ARCH_LIST="${VLLM_CUDA_ARCH_LIST}" \
    TORCH_CUDA_ARCH_LIST="${VLLM_TORCH_CUDA_ARCH_LIST}" \
    MAX_JOBS="${MAX_JOBS}" \
    NVCC_THREADS="${NVCC_THREADS}" \
    CMAKE_BUILD_PARALLEL_LEVEL="${MAX_JOBS}"

ARG UCCL_REPO="https://github.com/uccl-project/uccl.git"
ARG UCCL_COMMIT="e22a3e8fcd636f7efbbd90900458087a41ff73ce"
ARG UCCL_NANOBIND_VERSION="3.0.1"
ARG UCCL_NUM_LOCAL_GPUS="4"
ARG UCCL_MAX_JOBS="16"
COPY Alps-Images/apps/vllm/patches/common/uccl/ /opt/alps-uccl-common-patches/
COPY Alps-Images/apps/vllm/patches/cuda/uccl/ /opt/alps-uccl-cuda-patches/
RUN set -eux; \
    source /opt/alps/vllm-build-env.sh; \
    vllm_build_begin; \
    pip_install python --no-cache-dir --upgrade "nanobind==${UCCL_NANOBIND_VERSION}"; \
    printf 'CUDA_ARCH_LIST=%s\nTORCH_CUDA_ARCH_LIST=%s\nMAX_JOBS=%s\nNVCC_THREADS=%s\n' \
      "${CUDA_ARCH_LIST}" "${TORCH_CUDA_ARCH_LIST}" "${MAX_JOBS}" "${NVCC_THREADS}"; \
    rm -rf /tmp/uccl /tmp/uccl-ep-build; \
    git init -q /tmp/uccl; \
    git -C /tmp/uccl remote add origin "${UCCL_REPO}"; \
    git -C /tmp/uccl fetch --depth=1 origin "${UCCL_COMMIT}"; \
    git -C /tmp/uccl checkout -q --detach FETCH_HEAD; \
    test "$(git -C /tmp/uccl rev-parse HEAD)" = "${UCCL_COMMIT}"; \
    shopt -s nullglob; uccl_patch_files=(/opt/alps-uccl-common-patches/*.patch /opt/alps-uccl-cuda-patches/*.patch); shopt -u nullglob; \
    for patch_file in "${uccl_patch_files[@]}"; do \
      echo "Applying UCCL patch: ${patch_file}"; \
      git -C /tmp/uccl apply --check "${patch_file}"; \
      git -C /tmp/uccl apply "${patch_file}"; \
    done; \
    uccl_site_packages="$(python -c 'import site; paths = site.getsitepackages(); print(paths[0] if paths else "")')"; \
    test -n "${uccl_site_packages}" || { echo "ERROR: site-packages not found" >&2; exit 1; }; \
    cd /tmp/uccl/ep; \
    LIBFABRIC_HOME=/usr \
      USE_LIBFABRIC_CXI=1 \
      UCCL_EP_FORCE_GRACE_HOPPER=1 \
      PER_EXPERT_BATCHING=1 \
      NUM_MAX_NVL_PEERS="${UCCL_NUM_LOCAL_GPUS}" \
      MAX_JOBS="${UCCL_MAX_JOBS}" \
      MAX_NUM_GPUS="${UCCL_NUM_LOCAL_GPUS}" \
      TORCH_CUDA_ARCH_LIST="${VLLM_TORCH_CUDA_ARCH_LIST}" \
      INSTALL_DIR="${uccl_site_packages}/uccl" \
      python setup.py build --build-base /tmp/uccl-ep-build install; \
    printf '%s\n' '"""UCCL expert-parallel extension."""' > "${uccl_site_packages}/uccl/__init__.py"; \
    cp -LR /tmp/uccl/ep/deep_ep_wrapper/deep_ep "${uccl_site_packages}/deep_ep"; \
    vllm_build_end; \
    rm -rf /tmp/uccl /tmp/uccl-ep-build

ARG VLLM_REPO="https://github.com/vllm-project/vllm.git"
ARG VLLM_REF="v0.31.0"
ARG VLLM_VERSION_OVERRIDE=""
COPY Alps-Images/apps/vllm/patches/common/vllm/ /opt/alps-vllm-patches/
COPY Alps-Images/apps/vllm/patches/cuda/vllm/ /opt/alps-vllm-cuda-patches/
RUN set -eux; \
    source /opt/alps/vllm-build-env.sh; \
    vllm_build_begin; \
    rm -rf /tmp/vllm; \
    git clone --recursive "${VLLM_REPO}" /tmp/vllm; \
    cd /tmp/vllm; \
    git checkout -q "${VLLM_REF}"; \
    git submodule update --init --recursive; \
    shopt -s nullglob; \
    vllm_patch_files=(/opt/alps-vllm-patches/*.patch /opt/alps-vllm-cuda-patches/*.patch); \
    shopt -u nullglob; \
    for patch_file in "${vllm_patch_files[@]}"; do \
      echo "Applying vLLM patch: ${patch_file}"; \
      git apply --check "${patch_file}"; \
      git apply "${patch_file}"; \
    done; \
    python -c 'from pathlib import Path; from packaging.requirements import Requirement; requirements = [Requirement(line.split("#", 1)[0].strip()) for line in Path("requirements/cuda.txt").read_text().splitlines() if line.strip().startswith(("nvidia-cutlass-dsl", "quack-kernels"))]; assert {r.name for r in requirements} == {"nvidia-cutlass-dsl", "quack-kernels"}, requirements; Path("/opt/alps/vllm-cuda-dsl-requirements.txt").write_text("\n".join(map(str, requirements)) + "\n")'; \
    grep -n 'CUDA_ARCH_LIST' CMakeLists.txt; \
    python tools/use_existing_torch.py --prefix; \
    if [ -z "${VLLM_VERSION_OVERRIDE}" ] && [[ "${VLLM_REF}" == v[0-9]* ]]; then \
      export VLLM_VERSION_OVERRIDE="${VLLM_REF#v}"; \
    fi; \
    build_requirements="requirements/build/cuda.txt"; \
    if [ ! -f "${build_requirements}" ]; then build_requirements="requirements/build.txt"; fi; \
    awk 'BEGIN { IGNORECASE=1 } !($0 ~ /^torch==/ || $0 ~ /^torchaudio==/ || $0 ~ /^torchvision==/) { print }' "${build_requirements}" > /tmp/vllm-build-requirements.txt; \
    pip_install python --no-cache-dir -r /tmp/vllm-build-requirements.txt; \
    awk 'BEGIN { IGNORECASE=1 } !($0 ~ /^torch==/ || $0 ~ /^torchaudio==/ || $0 ~ /^torchvision==/ || $0 ~ /^cuda-toolkit/ || $0 ~ /^humming-kernels/ || $0 ~ /^nvidia-cuda-/ || $0 ~ /^nvidia-cudnn-frontend/ || $0 ~ /^nvidia-nvjitlink/ || $0 ~ /^nvidia-nvvm/ || $0 ~ /^tokenspeed-mla/) { print }' requirements/cuda.txt > requirements/cuda-alps.txt; \
    pip_install python --no-cache-dir -r requirements/cuda-alps.txt; \
    python setup.py bdist_wheel --dist-dir /tmp/vllm-dist --py-limited-api=cp38; \
    pip_install python --no-cache-dir --no-deps /tmp/vllm-dist/*.whl; \
    pip_install python --no-cache-dir "ray[default]" sentencepiece tiktoken; \
    torch_lib_dir="$(python -c 'import os, torch; print(os.path.join(os.path.dirname(torch.__file__), "lib"))')"; \
    test -d "${torch_lib_dir}"; \
    printf '%s\n' "${torch_lib_dir}" > /etc/ld.so.conf.d/99-alps-vllm-torch.conf; \
    ldconfig; \
    vllm_build_end; \
    rm -rf /tmp/vllm /tmp/vllm-dist /tmp/vllm-build-requirements.txt

ARG MODEL_STREAMER_REPO="https://github.com/dsx-ai-factory/model-streamer"
ARG MODEL_STREAMER_VERSION="0.16.1"
# Release asset digests: https://api.github.com/repos/dsx-ai-factory/model-streamer/releases/tags/0.16.1
ARG MODEL_STREAMER_SHA256_AARCH64="035cc282935d7d55032ce2da97507b3d94201e647d622bd44476a6ef9f04f824"
ARG MODEL_STREAMER_SHA256_X86_64="0f9958ecdef6786347b855f345d3076a039201f6f2c0e22dd52c74eef8941430"
RUN set -eux; \
    source /opt/alps/package-helpers.sh; \
    export PIP_CONSTRAINT=/opt/alps/vllm-base-pins.txt; \
    arch="$(uname -m)"; \
    case "${arch}" in \
      aarch64) model_streamer_sha256="${MODEL_STREAMER_SHA256_AARCH64}" ;; \
      x86_64) model_streamer_sha256="${MODEL_STREAMER_SHA256_X86_64}" ;; \
      *) echo "ERROR: no pinned Model Streamer wheel for ${arch}" >&2; exit 1 ;; \
    esac; \
    pip_install python --no-cache-dir \
      "${MODEL_STREAMER_REPO}/releases/download/${MODEL_STREAMER_VERSION}/runai_model_streamer-${MODEL_STREAMER_VERSION}-py3-none-manylinux2014_${arch}.whl#sha256=${model_streamer_sha256}"; \
    python -m pip uninstall -y nixl nixl-cu12 nixl-cu13; \
    rm -rf /root/.cache/pip

RUN set -eux; \
    while IFS= read -r pin; do \
      package="${pin%%==*}"; \
      expected="${pin#*==}"; \
      actual="$(python -c 'import importlib.metadata as m, sys; print(m.version(sys.argv[1]))' "${package}")"; \
      test "${actual}" = "${expected}"; \
    done < /opt/alps/vllm-base-pins.txt; \
    python -c 'import torch, vllm; print("torch={} cuda={}".format(torch.__version__, torch.version.cuda)); print("vllm={}".format(getattr(vllm, "__version__", "unknown")))'; \
    python -c 'import vllm.models.deepseek_v32; print("deepseek_v32=clean")'; \
    python -c 'from vllm.model_executor.models.registry import ModelRegistry; print("supported_archs={}".format(len(ModelRegistry.get_supported_archs()))); info = ModelRegistry.models["DeepseekV32ForCausalLM"].inspect_model_cls(); print("DeepseekV32ForCausalLM={}".format(info))'; \
    python -c 'from vllm.model_executor.layers.fused_moe.config import PrecisionConfig; print("triton_kernels.PrecisionConfig={}".format(PrecisionConfig))'; \
    python -c 'from pathlib import Path; import importlib.metadata as m; from packaging.requirements import Requirement; import cutlass.cute, quack; from vllm.model_executor.kernels.linear.cute_dsl.ll_bf16 import is_available; requirements = [Requirement(line) for line in Path("/opt/alps/vllm-cuda-dsl-requirements.txt").read_text().splitlines()]; versions = {r.name: m.version(r.name) for r in requirements if r.marker is None or r.marker.evaluate()}; assert set(versions) == {"nvidia-cutlass-dsl", "quack-kernels"}, versions; assert all(r.specifier.contains(versions[r.name], prereleases=True) for r in requirements if r.name in versions), (requirements, versions); assert is_available(), "ll_bf16 must be enabled"; print("cuda_dsl_requirements={} installed={} ll_bf16_available=True".format(requirements, versions))'; \
    python -c 'import uccl.ep; import deep_ep; print("uccl.ep={} deep_ep={}".format(uccl.ep.__file__, deep_ep.__file__))'; \
    python -c 'import flashinfer; print("flashinfer={}".format(flashinfer.__version__))'; \
    python -c 'import importlib.metadata as m; import runai_model_streamer; print("runai-model-streamer={} {}".format(m.version("runai-model-streamer"), runai_model_streamer.__file__))'; \
    python -c 'import importlib.util; assert importlib.util.find_spec("nixl") is None, "NIXL must not be installed"; print("nixl=absent")'; \
    cubin_dir="$(python -c 'from flashinfer.jit.env import FLASHINFER_CUBIN_DIR; print(FLASHINFER_CUBIN_DIR)')"; \
    echo "INFO: flashinfer resolves cubins from ${cubin_dir}"; \
    cubin_count="$(find "${cubin_dir}" -name '*.cubin' 2>/dev/null | wc -l)"; \
    if [ "${cubin_count}" -eq 0 ]; then \
      echo "MAYBE FATAL: no flashinfer cubins in ${cubin_dir};"; \
      echo "       the flashinfer-cubin package must be installed (it is pinned in"; \
      echo "       vLLM's requirements/cuda.txt and must not be filtered out above)"; \
    fi; \
    chmod -R a+rX "${cubin_dir}"; \
    echo "INFO: ${cubin_count} cubins pre-installed"; \
    du -sh "${cubin_dir}"; \
    echo "INFO: pip-installed CUDA packages after flashinfer install:"; \
    python -m pip list --format=freeze \
      | grep -i -E '^(cuda-toolkit|nvidia-|flashinfer)' \
      || echo "  (none)"; \
    python -m pip check || echo "WARN: inconsistent pip dependency resolution (see above)"; \
    uccl_ep_so="$(python -c 'import uccl.ep; print(uccl.ep.__file__)')"; \
    missing="$(ldd "${uccl_ep_so}" 2>/dev/null | awk '/not found/ { print }' || true)"; \
    if [ -n "${missing}" ]; then \
      echo "FATAL: UCCL-EP has unresolved dependencies:" >&2; \
      echo "${missing}" >&2; \
      exit 1; \
    fi; \
    all_missing="$(find "$(python -c 'import vllm; print(vllm.__path__[0])')" -name '*.so' \
                 -exec ldd {} + 2>/dev/null | awk '/not found/ { print }' || true)"; \
    ignored_missing="$(printf '%s\n' "${all_missing}" | awk '$1 == "libcuda.so.1" { print }')"; \
    missing="$(printf '%s\n' "${all_missing}" | awk 'NF && $1 != "libcuda.so.1" { print }')"; \
    if [ -n "${ignored_missing}" ]; then \
      echo "INFO: ignoring build-time unresolved host CUDA driver dependencies:"; \
      echo "${ignored_missing}"; \
    fi; \
    if [ -n "${missing}" ]; then \
      echo "FATAL: vLLM native extensions have unresolved dependencies:" >&2; \
      echo "${missing}" >&2; \
      exit 1; \
    fi; \
    echo "OK: vLLM smoke checks passed"

# Mooncake transfer engine (CXI)
COPY Alps-Images/apps/vllm/sources/install-mooncake.sh /opt/alps/install-mooncake.sh
COPY Alps-Images/apps/vllm/patches/common/mooncake /opt/alps/mooncake-patches

RUN set -eux; \
    chmod u+x /opt/alps/install-mooncake.sh; \
    /opt/alps/install-mooncake.sh cuda

# Tests shipped with the image
COPY Alps-Images/apps/vllm/tests/ /opt/tests/vllm/
RUN chmod -R a+rX /opt/tests/vllm

ARG OCI_SOURCE="unknown"
ARG OCI_REVISION="unknown"
ARG OCI_CREATED="unknown"
ARG OCI_DESCRIPTION="unknown"
ARG CSCS_ALPS_GIT_COMMIT_SHORT="unknown"

# Podman needs a RUN boundary to refresh cached labels after ARG-only changes.
RUN : "${OCI_SOURCE}" "${OCI_REVISION}" "${OCI_CREATED}" \
      "${OCI_DESCRIPTION}" "${CSCS_ALPS_GIT_COMMIT_SHORT}"

LABEL org.opencontainers.image.source="${OCI_SOURCE}" \
      org.opencontainers.image.revision="${OCI_REVISION}" \
      org.opencontainers.image.created="${OCI_CREATED}" \
      org.opencontainers.image.description="${OCI_DESCRIPTION}" \
      com.cscs.alps.git.repo="${OCI_SOURCE}" \
      com.cscs.alps.git.commit="${OCI_REVISION}" \
      com.cscs.alps.git.commit_short="${CSCS_ALPS_GIT_COMMIT_SHORT}"
LABEL org.opencontainers.image.uccl.revision="${UCCL_COMMIT}" \
      org.opencontainers.image.runai-model-streamer.version="${MODEL_STREAMER_VERSION}"

