# -----------------------------------------------------------------------------
# NCCL/RCCL-compatible defaults
# -----------------------------------------------------------------------------
# RCCL intentionally supports many NCCL_* runtime variables. Keep only defaults
# here that are expected to apply to both NVIDIA NCCL and AMD RCCL.

# Optional informational markers; will be injected at build time when available.
defvar NCCL_VERSION "${NCCL_VERSION:-}"
defvar AWS_OFI_NCCL_VERSION "${AWS_OFI_NCCL_VERSION:-}"

# This forces NCCL/RCCL-compatible stacks to use the libfabric plugin, enabling
# full use of the Slingshot network. If the plugin can not be found,
# applications will fail to start instead of silently falling back to TCP.
defvar NCCL_NET "AWS Libfabric"

# Use all interfaces that match "hsn" (the prefix of the Slingshot interfaces,
# hsn = high-speed network) for bootstrap/socket communication.
defvar NCCL_SOCKET_IFNAME "hsn"

# Allow the use of different NICs for the same ring/tree. This is suited for
# networks where all NICs from a node are connected to the same switch, like
# Slingshot.
defvar NCCL_CROSS_NIC "0"

# Starting with NCCL 2.27 a new protocol (LL128) was enabled by default, which
# typically performs worse on Slingshot. RCCL also accepts NCCL_PROTO.
defvar NCCL_PROTO "^LL128"

# Number of network channels to be used for pairwise communication.
defvar NCCL_NCHANNELS_PER_NET_PEER "4"

# Number of CPU helper threads used per socket transport network connection.
defvar NCCL_SOCKET_NTHREADS "4"

# Number of sockets opened by each helper thread of the socket transport.
defvar NCCL_NSOCKS_PERTHREAD "1"
