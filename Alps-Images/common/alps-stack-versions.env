# Shared Alps network-stack build defaults. Family profiles or explicit
# Containerfile build args may override these before the installer sources this
# file.

: "${BOOST_VER:=1.91.0}"
: "${BOOST_BUILD_JOBS:=32}"
: "${ALPS_BUILD_JOBS:=32}"
: "${ALPS_CMAKE_BUILD_JOBS:=${ALPS_BUILD_JOBS}}"
: "${XPMEM_REF:=3bcab55479489fdd93847fa04c58ab16e9c0b3fd}"

: "${CASSINI_HEADERS_VERSION:=release/shs-13.1.0}"
: "${CXI_DRIVER_VERSION:=release/shs-13.1.0}"
: "${LIBCXI_VERSION:=release/shs-13.1.0}"

: "${LIBFABRIC_COMMIT:=5de2d6a2df83595bcc38531cb91bf59495559495}"
: "${LIBFABRIC_PATCH:=}"

: "${UCX_VERSION:=1.20.1}"
: "${UCC_VERSION:=1.8.0}"
: "${OMPI_VER:=5.0.10}"

: "${AWS_OFI_NCCL_REPO:=https://github.com/aws/aws-ofi-nccl.git}"
: "${AWS_OFI_NCCL_COMMIT:=a2a6d08ea98296f99596b5c18b30b8a20d74f609}"
: "${AWS_OFI_NCCL_PATCH:=}"

: "${OSU_VERSION:=7.5.2}"

export \
    BOOST_VER BOOST_BUILD_JOBS ALPS_BUILD_JOBS ALPS_CMAKE_BUILD_JOBS XPMEM_REF \
    CASSINI_HEADERS_VERSION CXI_DRIVER_VERSION LIBCXI_VERSION \
    LIBFABRIC_COMMIT LIBFABRIC_PATCH \
    UCX_VERSION UCC_VERSION OMPI_VER \
    AWS_OFI_NCCL_REPO AWS_OFI_NCCL_COMMIT AWS_OFI_NCCL_PATCH \
    OSU_VERSION
