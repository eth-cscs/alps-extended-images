From 969e87e594c6369b9228036b478bc59eb326abf5 Mon Sep 17 00:00:00 2001
From: Andres Nowak <andresnowak52@gmail.com>
Date: Thu, 19 Nov 2026 14:48:05 +0100
Subject: [PATCH] prov/cxi: Use hybrid MR desc for HMEM operand copies

In hybrid MR desc mode, the IDC AMO and IDC RMA paths ignored the
caller's MR desc when the CPU copied the payload into the command.
They called cxip_txc_copy_from_hmem() with a NULL MD. With FI_HMEM
enabled, this maps the buffer through the MR cache for every
operation, although the user gave a valid desc. The DMA paths had the
same NULL MD for their operand copies (FI_ATOMIC_WRITE, FI_MSWAP,
compare buffers and FI_INJECT bounce copies).

Add cxip_txc_mr_copy_md(). It returns the MD of the user MR when hybrid
MR desc mode is on, the MR belongs to the TX domain, the MD covers the
copied range, and the MD has a dev reg handle if the endpoint requires
one. Otherwise it returns NULL, which keeps the existing internal
mapping. Plumb the operand, compare and RMA source descs to all
cxip_txc_copy_from_hmem() calls that copy from user buffers.
---
 prov/cxi/include/cxip.h    | 37 ++++++++++++++++++++++
 prov/cxi/src/cxip_atomic.c | 65 ++++++++++++++++++++++++++++++--------
 prov/cxi/src/cxip_rma.c    | 18 ++++++++---
 3 files changed, 101 insertions(+), 19 deletions(-)

diff --git a/prov/cxi/include/cxip.h b/prov/cxi/include/cxip.h
index cd5005fea..65519d4f7 100644
--- a/prov/cxi/include/cxip.h
+++ b/prov/cxi/include/cxip.h
@@ -3947,6 +3947,43 @@ cxip_txc_copy_from_hmem(struct cxip_txc *txc, struct cxip_md *hmem_md,
 	return FI_SUCCESS;
 }
 
+/* Return the MD of a user MR desc for a CPU copy of [buf, buf + len), to pass
+ * to cxip_txc_copy_from_hmem(). This lets the copy skip the internal mapping
+ * (MR cache lookup) when hybrid MR desc mode gives a valid desc.
+ *
+ * Return NULL, so that the copy maps the buffer internally as before, if
+ * hybrid MR desc mode is off, the MR has no MD, the MR belongs to a different
+ * domain, the MD does not cover the range, or the MD lacks a dev reg handle
+ * that the endpoint requires.
+ */
+static inline struct cxip_md *
+cxip_txc_mr_copy_md(struct cxip_txc *txc, struct cxip_mr *mr,
+		    const void *buf, size_t len)
+{
+	struct cxip_md *md;
+	uintptr_t start;
+	uintptr_t end;
+
+	if (!mr || !buf || !txc->domain->hybrid_mr_desc || !txc->hmem)
+		return NULL;
+
+	md = mr->md;
+	if (!md || mr->domain != txc->domain)
+		return NULL;
+
+	start = (uintptr_t)md->info.iov.iov_base;
+	end = start + md->info.iov.iov_len;
+	if ((uintptr_t)buf < start || (uintptr_t)buf > end ||
+	    len > end - (uintptr_t)buf)
+		return NULL;
+
+	if (txc->ep_obj->require_dev_reg_copy[md->info.iface] &&
+	    !md->handle_valid)
+		return NULL;
+
+	return md;
+}
+
 static inline
 int cxip_set_recv_match_id(struct cxip_rxc *rxc, fi_addr_t src_addr,
 			   bool auth_key, uint32_t *match_id, uint16_t *vni)
