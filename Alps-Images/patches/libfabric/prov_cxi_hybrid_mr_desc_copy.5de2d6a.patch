 					      atomic_type_len);
 		if (ret) {
 			TXC_WARN(txc, "cxip_txc_copy_from_hmem failed: %d:%s\n",
@@ -728,8 +738,8 @@ static int cxip_amo_emit_idc(struct cxip_txc *txc,
 			goto err_unmap_result_buf;
 		}
 
-		ret = cxip_txc_copy_from_hmem(txc, NULL, &hmem_compare, compare,
-					      atomic_type_len);
+		ret = cxip_txc_copy_from_hmem(txc, compare_md, &hmem_compare,
+					      compare, atomic_type_len);
 		if (ret) {
 			TXC_WARN(txc, "cxip_txc_copy_from_hmem failed: %d:%s\n",
 				 ret, fi_strerror(-ret));
@@ -755,7 +765,8 @@ static int cxip_amo_emit_idc(struct cxip_txc *txc,
 	case FI_ATOMIC_WRITE:
 		assert(compare == NULL);
 
-		ret = cxip_txc_copy_from_hmem(txc, NULL, &idc_amo_cmd.op2_word1,
+		ret = cxip_txc_copy_from_hmem(txc, buf_md,
+					      &idc_amo_cmd.op2_word1,
 					      buf, atomic_type_len);
 		if (ret) {
 			TXC_WARN(txc, "cxip_txc_copy_from_hmem failed: %d:%s\n",
@@ -765,7 +776,8 @@ static int cxip_amo_emit_idc(struct cxip_txc *txc,
 
 		/* Fall through. */
 	default:
-		ret = cxip_txc_copy_from_hmem(txc, NULL, &idc_amo_cmd.op1_word1,
+		ret = cxip_txc_copy_from_hmem(txc, buf_md,
+					      &idc_amo_cmd.op1_word1,
 					      buf, atomic_type_len);
 		if (ret) {
 			TXC_WARN(txc, "cxip_txc_copy_from_hmem failed: %d:%s\n",
@@ -776,7 +788,8 @@ static int cxip_amo_emit_idc(struct cxip_txc *txc,
 
 	if (compare) {
 		/* Note: 16-byte value will overflow into op2_word2 */
-		ret = cxip_txc_copy_from_hmem(txc, NULL, &idc_amo_cmd.op2_word1,
+		ret = cxip_txc_copy_from_hmem(txc, compare_md,
+					      &idc_amo_cmd.op2_word1,
 					      compare, atomic_type_len);
 		if (ret) {
 			TXC_WARN(txc, "cxip_txc_copy_from_hmem failed: %d:%s\n",
@@ -878,7 +891,8 @@ static int cxip_amo_emit_dma(struct cxip_txc *txc,
 			     enum cxip_amo_req_type req_type,
 			     const struct fi_msg_atomic *msg, void *buf,
 			     void *compare, void *result,
-			     struct cxip_mr *buf_mr, struct cxip_mr *result_mr,
+			     struct cxip_mr *buf_mr, struct cxip_mr *compare_mr,
+			     struct cxip_mr *result_mr,
 			     uint64_t key, uint64_t remote_offset,
 			     union c_fab_addr *dfa, uint8_t *idx_ext,
 			     uint16_t vni, enum c_atomic_op atomic_op,
@@ -900,15 +914,25 @@ static int cxip_amo_emit_dma(struct cxip_txc *txc,
 	uint64_t hmem_buf;
 	uint64_t hmem_compare;
 	struct cxip_md *buf_md;
+	struct cxip_md *buf_copy_md;
+	struct cxip_md *compare_copy_md;
 	struct cxip_md *result_md = NULL;
 	void *selective_completion_req;
 
 	/* MR desc cannot be value unless hybrid MR desc is enabled. */
 	if (!dom->hybrid_mr_desc) {
 		buf_mr = NULL;
+		compare_mr = NULL;
 		result_mr = NULL;
 	}
 
+	/* MDs for CPU copies of the user operand buffers. NULL makes the copy
+	 * map the buffer internally.
+	 */
+	buf_copy_md = cxip_txc_mr_copy_md(txc, buf_mr, buf, atomic_type_len);
+	compare_copy_md = cxip_txc_mr_copy_md(txc, compare_mr, compare,
+					      atomic_type_len);
+
 	/* Since fetching AMO with flush results in two commands, if the
 	 * target MR needs events, this would results in two remote MR counter
 	 * increments. Thus, this functionality cannot be supported.
@@ -990,7 +1014,7 @@ static int cxip_amo_emit_dma(struct cxip_txc *txc,
 				break;
 
 			case FI_MSWAP:
-				ret = cxip_txc_copy_from_hmem(txc, NULL,
+				ret = cxip_txc_copy_from_hmem(txc, buf_copy_md,
 							      &hmem_buf, buf,
 							      atomic_type_len);
 				if (ret) {
@@ -1000,7 +1024,8 @@ static int cxip_amo_emit_dma(struct cxip_txc *txc,
 					goto err_unmap_operand_buf;
 				}
 
-				ret = cxip_txc_copy_from_hmem(txc, NULL,
+				ret = cxip_txc_copy_from_hmem(txc,
+							      compare_copy_md,
 							      &hmem_compare,
 							      compare,
 							      atomic_type_len);
@@ -1019,7 +1044,7 @@ static int cxip_amo_emit_dma(struct cxip_txc *txc,
 
 			/* Copy over user payload for FI_INJECT operation. */
 			default:
-				ret = cxip_txc_copy_from_hmem(txc, NULL,
+				ret = cxip_txc_copy_from_hmem(txc, buf_copy_md,
 							      req->amo.ibuf,
 							      buf,
 							      atomic_type_len);
@@ -1100,7 +1125,13 @@ static int cxip_amo_emit_dma(struct cxip_txc *txc,
 	if (msg->op == FI_ATOMIC_WRITE) {
 		assert(compare == NULL);
 
-		ret = cxip_txc_copy_from_hmem(txc, NULL, &dma_amo_cmd.op2_word1,
+		/* For FI_INJECT, buf now points to the internal buffer. The MR
+		 * desc does not cover it, so the helper returns NULL then.
+		 */
+		buf_copy_md = cxip_txc_mr_copy_md(txc, buf_mr, buf,
+						  atomic_type_len);
+		ret = cxip_txc_copy_from_hmem(txc, buf_copy_md,
+					      &dma_amo_cmd.op2_word1,
 					      buf, atomic_type_len);
 		if (ret) {
 			TXC_WARN(txc,
@@ -1110,7 +1141,8 @@ static int cxip_amo_emit_dma(struct cxip_txc *txc,
 		}
 	} else if (compare) {
 		/* Note: 16-byte value will overflow into op2_word2 */
-		ret = cxip_txc_copy_from_hmem(txc, NULL, &dma_amo_cmd.op2_word1,
+		ret = cxip_txc_copy_from_hmem(txc, compare_copy_md,
+					      &dma_amo_cmd.op2_word1,
 					      compare, atomic_type_len);
 		if (ret) {
 			TXC_WARN(txc,
@@ -1249,6 +1281,7 @@ int cxip_amo_common(enum cxip_amo_req_type req_type, struct cxip_txc *txc,
 	uint8_t idx_ext;
 	uint32_t pid_idx;
 	struct cxip_mr *buf_mr = NULL;
+	struct cxip_mr *compare_mr = NULL;
 	struct cxip_mr *result_mr = NULL;
 	uint16_t vni;
 
@@ -1266,6 +1299,8 @@ int cxip_amo_common(enum cxip_amo_req_type req_type, struct cxip_txc *txc,
 		}
 
 		compare = comparev[0].addr;
+		if (comparedesc && comparedesc[0])
+			compare_mr = comparedesc[0];
 
 		/* FALLTHRU */
 	case CXIP_RQ_AMO_FETCH:
@@ -1352,13 +1387,15 @@ int cxip_amo_common(enum cxip_amo_req_type req_type, struct cxip_txc *txc,
 		      &idx_ext);
 	if (idc)
 		ret = cxip_amo_emit_idc(txc, req_type, msg, buf, compare,
-					result, result_mr, key, remote_offset,
+					result, buf_mr, compare_mr, result_mr,
+					key, remote_offset,
 					&dfa, &idx_ext, vni, atomic_op,
 					cswap_op, atomic_type, atomic_type_len,
 					flags, tclass);
 	else
 		ret = cxip_amo_emit_dma(txc, req_type, msg, buf, compare,
-					result, buf_mr, result_mr, key,
+					result, buf_mr, compare_mr, result_mr,
+					key,
 					remote_offset, &dfa, &idx_ext, vni,
 					atomic_op, cswap_op, atomic_type,
 					atomic_type_len, flags, tclass,
